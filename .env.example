# Guru Ji Vision uses Firebase AI Logic (App Check attestation) for Gemini API access.
# No client-side GEMINI_API_KEY is required.

# Optional: Server-side Google Places API (New) key for Netlify Function
# (/.netlify/functions/nearby-services-lookup). NEVER expose in frontend JS.
# When omitted, free India Post + OpenStreetMap + Admin-Verified Directory is used.
GOOGLE_PLACES_API_KEY=
