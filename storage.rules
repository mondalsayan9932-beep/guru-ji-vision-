rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Strictly Owner-Only Private Farmer Financial Documents (Max 5 MB, Safe Raster Images or PDF only)
    match /farmer_documents/{farmerUid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == farmerUid;
      allow write: if request.auth != null &&
        request.auth.uid == farmerUid &&
        request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/png',
          'image/jpeg',
          'image/jpg',
          'image/webp',
          'image/gif',
          'application/pdf'
        ];
      allow delete: if false;
    }

    // Admin Study Materials Document Uploads (Publicly readable, verified admin PDF/DOC/PPT/TXT up to 25 MB)
    match /study_materials/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (
          (
            request.auth.token.email == 'mondalsayan9932@gmail.com' &&
            request.auth.token.email_verified == true
          ) ||
          request.auth.token.founder == true ||
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        ) &&
        request.resource != null &&
        request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'text/plain'
        ] &&
        request.resource.size <= 25 * 1024 * 1024;
    }
  }
}
