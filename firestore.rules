        ]) &&
        incoming().keys().hasOnly([
          'title', 'subject', 'description', 'meetUrl', 'scheduledDate', 'scheduledTime',
          'scheduledAtEpochMs', 'hostName', 'hostUid', 'notifyStudents', 'published', 'createdAt', 'updatedAt'
        ]) &&
        isValidMeetingSession(incoming());

      allow update: if isSignedIn() &&
        isValidId(meetingId) &&
        isAuthorizedMeetingHost() &&
        (isSuperAdmin() || existing().hostUid == request.auth.uid) &&
        isValidMeetingSession(incoming()) &&
        incoming().hostUid == existing().hostUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
