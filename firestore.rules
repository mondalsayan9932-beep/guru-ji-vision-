      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.semester is int && data.semester >= 1 && data.semester <= 8 &&
        data.score is int && data.score >= 0 && data.score <= 200 &&
        data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 200 &&
        data.score <= data.totalQuestions &&
        data.percentage is int && data.percentage >= 0 && data.percentage <= 100 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidAiUsageLog(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.modelName is string && data.modelName.size() >= 2 && data.modelName.size() <= 80 &&
        data.feature in ['AI_CHAT', 'CROP_PHOTO_SCAN', 'PDF_EXTRACT', 'HEALTH_CHECK'] &&
        data.language in ['EN', 'BN'] &&
        data.promptTokens is int && data.promptTokens >= 0 && data.promptTokens <= 2000000 &&
        data.outputTokens is int && data.outputTokens >= 0 && data.outputTokens <= 2000000 &&
        data.latencyMs is int && data.latencyMs >= 0 && data.latencyMs <= 300000 &&
        data.success is bool &&
        data.hasImage is bool &&
        isValidTimestamp(data.createdAt);
    }

    function isValidErrorLog(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.source in ['FIRESTORE', 'AI_LOGIC', 'AUTH', 'SYSTEM'] &&
        data.severity in ['INFO', 'WARNING', 'CRITICAL'] &&
        data.module is string && data.module.size() >= 1 && data.module.size() <= 60 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        data.resolved is bool &&
        isValidTimestamp(data.createdAt);
    }

    function isValidContentReport(data) {
      return data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 &&
        data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 80 &&
        data.targetType in ['COMMUNITY_POST', 'COMMUNITY_COMMENT'] &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.targetTitle is string && data.targetTitle.size() >= 1 && data.targetTitle.size() <= 140 &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 300 &&
        data.status in ['PENDING', 'DISMISSED', 'ACTION_TAKEN'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAdminAuditLog(data) {
      return data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
        data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 120 &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
        data.targetType is string && data.targetType.size() >= 2 && data.targetType.size() <= 60 &&
        data.targetId is string && data.targetId.size() <= 128 &&
        data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 300 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidMeetingSession(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 80 &&
        data.description is string && data.description.size() <= 1000 &&
        data.meetUrl is string && data.meetUrl.size() >= 15 && data.meetUrl.size() <= 300 &&
        data.meetUrl.matches('^https://meet\\.google\\.com/[a-zA-Z0-9_\\-/?=&]+$') &&
        data.scheduledDate is string && data.scheduledDate.size() >= 8 && data.scheduledDate.size() <= 20 &&
        data.scheduledTime is string && data.scheduledTime.size() >= 3 && data.scheduledTime.size() <= 20 &&
        data.scheduledAtEpochMs is int && data.scheduledAtEpochMs >= 0 &&
        data.hostName is string && data.hostName.size() >= 2 && data.hostName.size() <= 80 &&
        data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
        data.notifyStudents is bool &&
        data.published is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidProfessorProfile(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 100 &&
        data.qualification is string && data.qualification.size() <= 100 &&
        data.subject is string && data.subject.size() <= 80 &&
        data.department is string && data.department.size() >= 2 && data.department.size() <= 100 &&
        data.email is string && data.email.size() <= 120 &&
        data.specialization is string && data.specialization.size() >= 2 && data.specialization.size() <= 200 &&
        data.avatarUrl is string && data.avatarUrl.size() <= 500 &&
        data.authorizedUid is string && data.authorizedUid.size() <= 128 &&
        data.canHostMeetings is bool &&
        data.active is bool &&
        data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 100 &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidProfessorAccountLink(data) {
      return data.professorId is string && data.professorId.size() >= 1 && data.professorId.size() <= 128 &&
        data.email is string && data.email.size() <= 120 &&
        data.canHostMeetings is bool &&
        data.active is bool &&
        data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidDoubtChatThread(data) {
      return data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 80 &&
        data.studentSemester is int && data.studentSemester >= 0 && data.studentSemester <= 8 &&
        data.professorId is string && data.professorId.size() >= 1 && data.professorId.size() <= 128 &&
        data.professorName is string && data.professorName.size() >= 2 && data.professorName.size() <= 100 &&
        data.professorEmail is string && data.professorEmail.size() <= 120 &&
        data.professorUid is string && data.professorUid.size() <= 128 &&
        data.lastMessagePreview is string && data.lastMessagePreview.size() <= 200 &&
        data.lastSenderRole in ['STUDENT', 'PROFESSOR'] &&
        data.unreadForStudent is int && data.unreadForStudent >= 0 && data.unreadForStudent <= 100000 &&
        data.unreadForProfessor is int && data.unreadForProfessor >= 0 && data.unreadForProfessor <= 100000 &&
        (!('serviceType' in data) || data.serviceType in ['STUDENT_CAREER', 'FARMER_ADVISOR']) &&
        (!('questionTitle' in data) || (data.questionTitle is string && data.questionTitle.size() <= 140)) &&
        (!('questionCategory' in data) || (data.questionCategory is string && data.questionCategory.size() <= 60)) &&
        (!('contactInfo' in data) || (data.contactInfo is string && data.contactInfo.size() <= 80)) &&
        (!('emailDeliveryStatus' in data) || data.emailDeliveryStatus in ['PENDING', 'SENT', 'FAILED', 'NOT_CONFIGURED']) &&
        (!('emailDeliveryError' in data) || (data.emailDeliveryError is string && data.emailDeliveryError.size() <= 240)) &&
        (!('emailDeliveryMessageId' in data) || (data.emailDeliveryMessageId is string && data.emailDeliveryMessageId.size() <= 128)) &&
        (!('studentLastReadAt' in data) || isValidTimestamp(data.studentLastReadAt)) &&
        (!('professorLastReadAt' in data) || isValidTimestamp(data.professorLastReadAt)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidDoubtMessage(data) {
      return data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
        data.professorId is string && data.professorId.size() >= 1 && data.professorId.size() <= 128 &&
        data.professorEmail is string && data.professorEmail.size() <= 120 &&
        data.professorUid is string && data.professorUid.size() <= 128 &&
        data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        data.senderRole in ['STUDENT', 'PROFESSOR'] &&
        data.text is string && data.text.size() <= 2000 &&
        data.hasImage is bool &&
        (data.text.size() >= 1 || data.hasImage == true) &&
        (!('imageBase64' in data) || (data.imageBase64 is string && data.imageBase64.size() <= 350000)) &&
        (!('questionTitle' in data) || (data.questionTitle is string && data.questionTitle.size() <= 140)) &&
        (!('questionCategory' in data) || (data.questionCategory is string && data.questionCategory.size() <= 60)) &&
        (!('emailDeliveryStatus' in data) || data.emailDeliveryStatus in ['PENDING', 'SENT', 'FAILED', 'NOT_CONFIGURED']) &&
        (!('emailDeliveryError' in data) || (data.emailDeliveryError is string && data.emailDeliveryError.size() <= 240)) &&
        data.readByRecipient is bool &&
        isValidTimestamp(data.createdAt);
    }

    // --- 1. USERS & PRIVATE STUDENT / FARMER FINANCIAL & QUIZ SUBCOLLECTIONS ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        incoming().userId == request.auth.uid &&
        incoming().role in ['STUDENT', 'FARMER'] &&
        (!('professorApprovalStatus' in incoming()) || incoming().professorApprovalStatus in ['NONE', 'PENDING']) &&
        incoming().keys().hasAll(['userId', 'displayName', 'email', 'role', 'institutionOrVillage', 'district', 'semester', 'language', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly([
          'userId', 'displayName', 'email', 'role', 'institutionOrVillage', 'district', 'semester', 'language',
          'phoneNumber', 'state', 'department', 'subjectSpecialization', 'requestedRole', 'professorApprovalStatus',
          'photoUrl', 'financialProfiles', 'lastActiveAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            isOwner(userId) &&
            (incoming().role in ['STUDENT', 'FARMER'] || incoming().role == existing().role) &&
            (
              !('professorApprovalStatus' in incoming()) ||
              incoming().professorApprovalStatus in ['NONE', 'PENDING'] ||
              (('professorApprovalStatus' in existing()) && incoming().professorApprovalStatus == existing().professorApprovalStatus)
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'email', 'role', 'institutionOrVillage', 'district', 'semester', 'language',
              'phoneNumber', 'state', 'department', 'subjectSpecialization', 'requestedRole', 'professorApprovalStatus',
              'photoUrl', 'financialProfiles', 'lastActiveAt', 'updatedAt'
            ])
          ) ||
          (
            isSuperAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'role', 'institutionOrVillage', 'district', 'semester', 'language',
              'phoneNumber', 'state', 'department', 'subjectSpecialization', 'requestedRole', 'professorApprovalStatus',
              'financialProfiles', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());

      // STRICTLY ISOLATED STUDENT FINANCIAL PROFILE (Owner + Student/Dual Profile ONLY)
      // A Farmer-only account CANNOT read or write Student financial records!
      match /studentFinancialTransactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && hasStudentFinancialAccess(userId);
        allow list: if isValidId(userId) && hasStudentFinancialAccess(userId);

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(transactionId) &&
          hasStudentFinancialAccess(userId) &&
          incoming().keys().hasAll(['userId', 'profileType', 'ledgerScope', 'title', 'amount', 'type', 'category', 'note', 'dateLabel', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'profileType', 'ledgerScope', 'title', 'amount', 'type', 'category', 'note', 'dateLabel', 'sharedWith', 'migratedFromLegacyId', 'createdAt', 'updatedAt']) &&
          isValidStudentFinancialTransaction(incoming(), userId);

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(transactionId) &&
          hasStudentFinancialAccess(userId) &&
          isValidStudentFinancialTransaction(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().profileType == existing().profileType &&
          incoming().ledgerScope == existing().ledgerScope &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'type', 'category', 'note', 'dateLabel', 'sharedWith', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(transactionId) && hasStudentFinancialAccess(userId);
      }

      match /studentFinancialBudgets/{budgetId} {
        allow get: if isValidId(userId) && isValidId(budgetId) && hasStudentFinancialAccess(userId);
        allow list: if isValidId(userId) && hasStudentFinancialAccess(userId);

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(budgetId) &&
          hasStudentFinancialAccess(userId) &&
          incoming().keys().hasAll(['userId', 'profileType', 'ledgerScope', 'name', 'kind', 'targetAmount', 'savedAmount', 'monthKey', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'profileType', 'ledgerScope', 'name', 'kind', 'targetAmount', 'savedAmount', 'monthKey', 'migratedFromLegacyId', 'createdAt', 'updatedAt']) &&
          isValidScopedFinancialBudget(incoming(), userId, 'student', 'STUDENT');

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(budgetId) &&
          hasStudentFinancialAccess(userId) &&
          isValidScopedFinancialBudget(incoming(), userId, 'student', 'STUDENT') &&
          incoming().userId == existing().userId &&
          incoming().profileType == existing().profileType &&
          incoming().ledgerScope == existing().ledgerScope &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'kind', 'targetAmount', 'savedAmount', 'monthKey', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(budgetId) && hasStudentFinancialAccess(userId);
      }

      // STRICTLY ISOLATED FARMER FINANCIAL PROFILE (Owner + Farmer/Dual Profile ONLY)
      // A Student-only account CANNOT read or write Farmer financial records!
      match /farmerFinancialTransactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && hasFarmerFinancialAccess(userId);
        allow list: if isValidId(userId) && hasFarmerFinancialAccess(userId);

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(transactionId) &&
          hasFarmerFinancialAccess(userId) &&
          incoming().keys().hasAll(['userId', 'profileType', 'ledgerScope', 'title', 'amount', 'type', 'category', 'note', 'dateLabel', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'profileType', 'ledgerScope', 'title', 'amount', 'type', 'category', 'note', 'dateLabel', 'cropTag', 'migratedFromLegacyId', 'createdAt', 'updatedAt']) &&
          isValidFarmerFinancialTransaction(incoming(), userId);

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(transactionId) &&
          hasFarmerFinancialAccess(userId) &&
          isValidFarmerFinancialTransaction(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().profileType == existing().profileType &&
          incoming().ledgerScope == existing().ledgerScope &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'type', 'category', 'note', 'dateLabel', 'cropTag', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(transactionId) && hasFarmerFinancialAccess(userId);
      }

      match /farmerFinancialBudgets/{budgetId} {
        allow get: if isValidId(userId) && isValidId(budgetId) && hasFarmerFinancialAccess(userId);
        allow list: if isValidId(userId) && hasFarmerFinancialAccess(userId);

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(budgetId) &&
          hasFarmerFinancialAccess(userId) &&
          incoming().keys().hasAll(['userId', 'profileType', 'ledgerScope', 'name', 'kind', 'targetAmount', 'savedAmount', 'monthKey', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'profileType', 'ledgerScope', 'name', 'kind', 'targetAmount', 'savedAmount', 'monthKey', 'migratedFromLegacyId', 'createdAt', 'updatedAt']) &&
          isValidScopedFinancialBudget(incoming(), userId, 'farmer', 'FARMER');

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(budgetId) &&
          hasFarmerFinancialAccess(userId) &&
          isValidScopedFinancialBudget(incoming(), userId, 'farmer', 'FARMER') &&
          incoming().userId == existing().userId &&
          incoming().profileType == existing().profileType &&
          incoming().ledgerScope == existing().ledgerScope &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'kind', 'targetAmount', 'savedAmount', 'monthKey', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(budgetId) && hasFarmerFinancialAccess(userId);
      }

      // Legacy Private Financial Transactions (Preserved for non-destructive migration & compatibility; scope cannot be flipped on update)
      match /transactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(transactionId) &&
          isOwner(userId) &&
          incoming().keys().hasAll(['title', 'amount', 'type', 'category', 'note', 'dateLabel', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['title', 'amount', 'type', 'category', 'note', 'dateLabel', 'sharedWith', 'ledgerScope', 'cropTag', 'createdAt', 'updatedAt']) &&
          isValidMoneyTransaction(incoming());

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(transactionId) &&
          isValidMoneyTransaction(incoming()) &&
          isOwner(userId) &&
          incoming().createdAt == existing().createdAt &&
          (!('ledgerScope' in existing()) || incoming().ledgerScope == existing().ledgerScope) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'type', 'category', 'note', 'dateLabel', 'sharedWith', 'ledgerScope', 'cropTag', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
      }

      // Legacy Private Budgets & Savings Goals (Preserved for non-destructive migration & compatibility)
      match /budgets/{budgetId} {
        allow get: if isValidId(userId) && isValidId(budgetId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(budgetId) &&
          isOwner(userId) &&
          incoming().keys().hasAll(['name', 'kind', 'targetAmount', 'savedAmount', 'monthKey', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['name', 'kind', 'targetAmount', 'savedAmount', 'monthKey', 'createdAt', 'updatedAt']) &&
          isValidFinancialGoal(incoming());

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(budgetId) &&
          isValidFinancialGoal(incoming()) &&
          isOwner(userId) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'kind', 'targetAmount', 'savedAmount', 'monthKey', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(budgetId) && isOwner(userId);
      }

      // Private Student Quiz Attempts (Owner ONLY)
      match /quizAttempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(attemptId) &&
          isOwner(userId) &&
          incoming().keys().hasAll(['semester', 'score', 'totalQuestions', 'createdAt']) &&
          incoming().keys().hasOnly(['semester', 'score', 'totalQuestions', 'mode', 'examCategory', 'subjectKey', 'durationSec', 'createdAt']) &&
          isValidQuizAttempt(incoming());

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
      }

      // Private Student Study Bookmarks & Continue Learning Progress (Owner ONLY)
      match /studyBookmarks/{bookmarkId} {
        allow get: if isValidId(userId) && isValidId(bookmarkId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create, update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(bookmarkId) &&
          isOwner(userId) &&
          incoming().keys().hasAll(['itemType', 'itemId', 'title', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['itemType', 'itemId', 'title', 'subject', 'semester', 'createdAt', 'updatedAt']) &&
          isValidStudyBookmark(incoming());

        allow delete: if isValidId(userId) && isValidId(bookmarkId) && isOwner(userId);
      }

      // Phase 6: Private User Skill Program Enrolment, Lesson Progress & Completion (Owner ONLY)
      match /skillProgress/{programId} {
        allow get: if isValidId(userId) && isValidId(programId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create, update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(programId) &&
          isOwner(userId) &&
          incoming().programId == programId &&
          incoming().keys().hasAll([
            'programId', 'programTitle', 'enrolled', 'totalLessons',
            'completedLessonIds', 'progressPercent', 'completed',
            'certificateUnlocked', 'enrolledAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'programId', 'programTitle', 'category', 'provider', 'enrolled',
            'totalLessons', 'completedLessonIds', 'progressPercent', 'completed',
            'certificateUnlocked', 'completedAt', 'enrolledAt', 'updatedAt'
          ]) &&
          isValidUserSkillProgress(incoming());

        allow delete: if isValidId(userId) && isValidId(programId) && isOwner(userId);
      }
    }

    // --- 2. FARMER QUERIES ---
    match /farmerQueries/{queryId} {
      allow get: if isSignedIn() && isValidId(queryId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(queryId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'OPEN' &&
        incoming().adminReply == '' &&
        incoming().keys().hasAll(['userId', 'farmerName', 'cropName', 'category', 'description', 'district', 'hasImage', 'imageSummary', 'status', 'adminReply', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'farmerName', 'cropName', 'category', 'description', 'district', 'hasImage', 'imageSummary', 'imageBase64', 'status', 'adminReply', 'createdAt', 'updatedAt']) &&
        isValidFarmerQuery(incoming());

      allow update: if isSignedIn() &&
        isValidId(queryId) &&
        isValidFarmerQuery(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'updatedAt'])) ||
          (existing().userId == request.auth.uid &&
           existing().status == 'OPEN' &&
           incoming().status == 'OPEN' &&
           incoming().adminReply == existing().adminReply &&
           incoming().diff(existing()).affectedKeys().hasOnly(['cropName', 'category', 'description', 'district', 'imageSummary', 'imageBase64', 'hasImage', 'updatedAt']))
        );

      allow delete: if isSignedIn() && isValidId(queryId) &&
        ((existing().userId == request.auth.uid && existing().status == 'OPEN') || isAdmin());
    }

    // --- 3. STUDY MATERIALS (Publicly Readable when Published) ---
    match /studyMaterials/{materialId} {
      allow get: if isValidId(materialId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(materialId) &&
        isValidStudyMaterial(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll(['title', 'semester', 'subject', 'category', 'summary', 'resourceUrl', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly([
          'title', 'titleBn', 'semester', 'subject', 'subjectKey', 'topic', 'category',
          'summary', 'summaryBn', 'contentText', 'contentTextBn',
          'sourceName', 'sourceUrl', 'referenceCitation', 'lastUpdatedDate',
          'downloadPermitted', 'contentOrigin', 'examTags', 'popularityScore',
          'verifiedForAi', 'language', 'youtubeUrl', 'youtubeVideoId', 'thumbnailUrl',
          'examCategory', 'examYear', 'answerKeyUrl', 'pyqOrigin', 'fileName', 'fileType',
          'resourceUrl', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(materialId) &&
        isValidStudyMaterial(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'titleBn', 'semester', 'subject', 'subjectKey', 'topic', 'category',
          'summary', 'summaryBn', 'contentText', 'contentTextBn',
          'sourceName', 'sourceUrl', 'referenceCitation', 'lastUpdatedDate',
          'downloadPermitted', 'contentOrigin', 'examTags', 'popularityScore',
          'verifiedForAi', 'language', 'youtubeUrl', 'youtubeVideoId', 'thumbnailUrl',
          'examCategory', 'examYear', 'answerKeyUrl', 'pyqOrigin', 'fileName', 'fileType',
          'resourceUrl', 'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(materialId) && isAdmin();
    }

    // --- 4. QUIZZES / MCQs (Publicly Readable when Published) ---
    match /quizzes/{quizId} {
      allow get: if isValidId(quizId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(quizId) &&
        isValidQuizQuestion(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll(['title', 'semester', 'subject', 'questionText', 'options', 'correctIndex', 'explanation', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly([
          'title', 'semester', 'subject', 'subjectKey', 'topic',
          'questionText', 'questionTextBn', 'options', 'correctIndex',
          'explanation', 'explanationBn', 'questionType', 'difficulty',
          'examCategory', 'examYear', 'sourcePaper', 'sourceUrl',
          'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(quizId) &&
        isValidQuizQuestion(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'semester', 'subject', 'subjectKey', 'topic',
          'questionText', 'questionTextBn', 'options', 'correctIndex',
          'explanation', 'explanationBn', 'questionType', 'difficulty',
          'examCategory', 'examYear', 'sourcePaper', 'sourceUrl',
          'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(quizId) && isAdmin();
    }

    // --- 5. CAREER OPPORTUNITIES (Publicly Readable when Published) ---
    match /careerOpportunities/{careerId} {
      allow get: if isValidId(careerId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(careerId) &&
        isValidCareerOpportunity(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll(['title', 'organization', 'category', 'eligibility', 'deadline', 'description', 'applyUrl', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['title', 'organization', 'category', 'eligibility', 'deadline', 'description', 'applyUrl', 'published', 'createdBy', 'createdAt', 'updatedAt']) &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(careerId) &&
        isValidCareerOpportunity(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'organization', 'category', 'eligibility', 'deadline', 'description', 'applyUrl', 'published', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(careerId) && isAdmin();
    }

    // --- 6. COMMUNITY POSTS (Active Posts Publicly Readable) ---
    match /communityPosts/{postId} {
      allow get: if isValidId(postId) &&
        (existing().status == 'ACTIVE' || (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin());
      allow list: if existing().status == 'ACTIVE' || (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(postId) &&
        incoming().authorId == request.auth.uid &&
        incoming().status == 'ACTIVE' &&
        incoming().helpfulCount == 0 &&
        (!('commentCount' in incoming()) || incoming().commentCount == 0) &&
        incoming().keys().hasAll(['authorId', 'authorName', 'collegeGroup', 'topic', 'title', 'body', 'helpfulCount', 'status', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly([
          'authorId', 'authorName', 'collegeGroup', 'topic', 'board', 'category',
          'district', 'commentCount', 'title', 'body', 'helpfulCount', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidCommunityPost(incoming());

      allow update: if isSignedIn() &&
        isValidId(postId) &&
        isValidCommunityPost(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (existing().authorId == request.auth.uid &&
           existing().status == 'ACTIVE' &&
           incoming().status == 'ACTIVE' &&
           incoming().helpfulCount == existing().helpfulCount &&
           (!('board' in existing()) || incoming().board == existing().board) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['collegeGroup', 'topic', 'category', 'district', 'title', 'body', 'updatedAt'])) ||
          (existing().status == 'ACTIVE' &&
           incoming().status == 'ACTIVE' &&
           incoming().helpfulCount == existing().helpfulCount + 1 &&
           incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount', 'updatedAt']))
        );

      allow delete: if isSignedIn() && isValidId(postId) &&
        (existing().authorId == request.auth.uid || isAdmin());

      // Threaded Comments & Replies under each Community / Women Farmer Discussion Post
      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId) &&
          (existing().status == 'ACTIVE' || (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin());
        allow list: if isValidId(postId) &&
          (existing().status == 'ACTIVE' || (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin());

        allow create: if isSignedIn() &&
          isValidId(postId) &&
          isValidId(commentId) &&
          incoming().postId == postId &&
          incoming().authorId == request.auth.uid &&
          incoming().status == 'ACTIVE' &&
          incoming().keys().hasAll(['postId', 'authorId', 'authorName', 'body', 'status', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['postId', 'parentCommentId', 'authorId', 'authorName', 'body', 'status', 'createdAt', 'updatedAt']) &&
          isValidCommunityComment(incoming());

        allow update: if isSignedIn() &&
          isValidId(postId) &&
          isValidId(commentId) &&
          isValidCommunityComment(incoming()) &&
          incoming().authorId == existing().authorId &&
          incoming().postId == existing().postId &&
          incoming().createdAt == existing().createdAt &&
          ((!('parentCommentId' in existing()) && !('parentCommentId' in incoming())) ||
           (('parentCommentId' in existing()) && ('parentCommentId' in incoming()) && incoming().parentCommentId == existing().parentCommentId)) &&
          (
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            (existing().authorId == request.auth.uid &&
             existing().status == 'ACTIVE' &&
             incoming().status == 'ACTIVE' &&
             incoming().diff(existing()).affectedKeys().hasOnly(['body', 'updatedAt']))
          );

        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) &&
          (existing().authorId == request.auth.uid || isAdmin());
      }

      // Per-User Authenticated Likes / Reactions (Zero PII — Document ID == Auth UID)
      match /likes/{likerUid} {
        allow get, list: if isValidId(postId);

        allow create, update: if isSignedIn() &&
          isValidId(postId) &&
          likerUid == request.auth.uid &&
          incoming().userId == request.auth.uid &&
          incoming().keys().hasAll(['userId', 'reaction', 'createdAt']) &&
          incoming().keys().hasOnly(['userId', 'reaction', 'createdAt']) &&
          isValidCommunityLike(incoming());

        allow delete: if isSignedIn() && isValidId(postId) &&
          (likerUid == request.auth.uid || isAdmin());
      }
    }

    // --- 7. ANNOUNCEMENTS (Active Notices Publicly Readable) ---
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll(['title', 'message', 'audience', 'active', 'createdBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['title', 'message', 'audience', 'active', 'createdBy', 'createdAt', 'updatedAt']) &&
        (isAdmin() || (isAuthorizedMeetingHost() && incoming().audience == 'STUDENTS'));

      allow update: if isSignedIn() &&
        isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'audience', 'active', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(announcementId) && isAdmin();
    }

    // --- 8. GLOBAL APP SETTINGS & OWNER FEATURE FLAGS (Public Global Config Read, Founder-Only Writes) ---
    match /appSettings/{settingId} {
      allow get: if settingId == 'global';
      allow list: if isSuperAdmin();

      allow create, update: if isSignedIn() &&
        settingId == 'global' &&
        isValidAppSettings(incoming()) &&
        incoming().keys().hasAll(['whatsappNumber', 'supportEmail', 'aboutText', 'heroHeadline', 'updatedAt']) &&
        incoming().keys().hasOnly([
          'whatsappNumber', 'whatsappGroupInviteUrl', 'supportEmail', 'aboutText', 'heroHeadline',
          'studentModuleEnabled', 'moneyManagerEnabled', 'farmerModuleEnabled',
          'toolsModuleEnabled', 'aiAssistantEnabled', 'careerModuleEnabled',
          'communityModuleEnabled', 'meetingZoneEnabled', 'doubtZoneEnabled',
          'aiModelName', 'aiFreeSearchEnabled', 'aiDailyLimitPerUser', 'aiPaidServicesApproved',
          'maintenanceBanner', 'updatedAt'
        ]) &&
        isSuperAdmin();

      allow delete: if false;
    }

    // --- 9. ADMIN ROLE REGISTRY (Super Admin Only for mutations) ---
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
        isValidId(adminUid) &&
        isValidAdminRecord(incoming()) &&
        incoming().addedBy == request.auth.uid &&
        incoming().keys().hasAll(['email', 'roleTitle', 'addedBy', 'createdAt']) &&
        incoming().keys().hasOnly(['email', 'roleTitle', 'addedBy', 'createdAt']) &&
        isSuperAdmin();

      allow update: if isSignedIn() &&
        isValidId(adminUid) &&
        isValidAdminRecord(incoming()) &&
        incoming().addedBy == existing().addedBy &&
        incoming().createdAt == existing().createdAt &&
        isSuperAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'roleTitle']);

      allow delete: if isSignedIn() && isValidId(adminUid) && isSuperAdmin();
    }

    // --- 10. OWNER TELEMETRY: ACTIVITY EVENTS (Owner-Only Read) ---
    match /activityEvents/{eventId} {
      allow get: if isValidId(eventId) && isSuperAdmin();
      allow list: if isSuperAdmin();

      allow create: if isSignedIn() &&
        isValidId(eventId) &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll(['userId', 'userRole', 'eventType', 'module', 'detail', 'createdAt']) &&
        incoming().keys().hasOnly(['userId', 'userRole', 'eventType', 'module', 'detail', 'createdAt']) &&
        isValidActivityEvent(incoming());

      allow update: if false;
      allow delete: if isValidId(eventId) && isSuperAdmin();
    }

    // --- 11. OWNER TELEMETRY: ONLINE EXAM STATISTICS (Owner-Only Aggregate Read) ---
    match /examStats/{statId} {
      allow get: if isValidId(statId) && (isSuperAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && existing().userId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(statId) &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll(['userId', 'semester', 'score', 'totalQuestions', 'percentage', 'createdAt']) &&
        incoming().keys().hasOnly(['userId', 'semester', 'score', 'totalQuestions', 'percentage', 'createdAt']) &&
        isValidExamStat(incoming());

      allow update: if false;
      allow delete: if isValidId(statId) && isSuperAdmin();
    }

    // --- 12. OWNER TELEMETRY: GEMINI AI USAGE & COST LOGS (Owner-Only Read) ---
    match /aiUsageLogs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isSuperAdmin();

      allow create: if isSignedIn() &&
        isValidId(logId) &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll(['userId', 'modelName', 'feature', 'language', 'promptTokens', 'outputTokens', 'latencyMs', 'success', 'hasImage', 'createdAt']) &&
        incoming().keys().hasOnly(['userId', 'modelName', 'feature', 'language', 'promptTokens', 'outputTokens', 'latencyMs', 'success', 'hasImage', 'createdAt']) &&
        isValidAiUsageLog(incoming());

      allow update: if false;
      allow delete: if isValidId(logId) && isSuperAdmin();
    }

    // --- 13. OWNER TELEMETRY: ERROR LOGS & SYSTEM HEALTH (Owner-Only Read & Resolve) ---
    match /errorLogs/{errorId} {
      allow get: if isValidId(errorId) && isSuperAdmin();
      allow list: if isSuperAdmin();

      allow create: if isSignedIn() &&
        isValidId(errorId) &&
        incoming().userId == request.auth.uid &&
        incoming().resolved == false &&
        incoming().keys().hasAll(['userId', 'source', 'severity', 'module', 'message', 'resolved', 'createdAt']) &&
        incoming().keys().hasOnly(['userId', 'source', 'severity', 'module', 'message', 'resolved', 'createdAt']) &&
        isValidErrorLog(incoming());

      allow update: if isSignedIn() &&
        isValidId(errorId) &&
        isValidErrorLog(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        isSuperAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['resolved']);

      allow delete: if isValidId(errorId) && isSuperAdmin();
    }

    // --- 14. REPORTED CONTENT MODERATION QUEUE ---
    match /contentReports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(reportId) &&
        incoming().reporterId == request.auth.uid &&
        incoming().status == 'PENDING' &&
        incoming().keys().hasAll(['reporterId', 'reporterName', 'targetType', 'targetId', 'targetTitle', 'reason', 'status', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['reporterId', 'reporterName', 'targetType', 'targetId', 'targetTitle', 'reason', 'status', 'createdAt', 'updatedAt']) &&
        isValidContentReport(incoming());

      allow update: if isSignedIn() &&
        isValidId(reportId) &&
        isValidContentReport(incoming()) &&
        incoming().reporterId == existing().reporterId &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isValidId(reportId) && isSuperAdmin();
    }

    // --- 15. FOUNDER ADMINISTRATIVE AUDIT LOG (Immutable, Founder-Only) ---
    match /adminAuditLogs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isSuperAdmin();

      allow create: if isSignedIn() &&
        isValidId(logId) &&
        isSuperAdmin() &&
        incoming().actorUid == request.auth.uid &&
        incoming().keys().hasAll(['actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'summary', 'createdAt']) &&
        incoming().keys().hasOnly(['actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'summary', 'createdAt']) &&
        isValidAdminAuditLog(incoming());

      allow update: if false;
      allow delete: if false;
    }

    // --- 16. MEETING ZONE (Google Meet Sessions — Published Publicly Readable) ---
    match /meetings/{meetingId} {
      allow get: if isValidId(meetingId) && (existing().published == true || isAuthorizedMeetingHost());
      allow list: if existing().published == true || isAuthorizedMeetingHost();

      allow create: if isSignedIn() &&
        isValidId(meetingId) &&
        isAuthorizedMeetingHost() &&
        incoming().hostUid == request.auth.uid &&
        incoming().keys().hasAll([
          'title', 'subject', 'description', 'meetUrl', 'scheduledDate', 'scheduledTime',
          'scheduledAtEpochMs', 'hostName', 'hostUid', 'notifyStudents', 'published', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'subject', 'description', 'meetUrl', 'scheduledDate', 'scheduledTime',
          'scheduledAtEpochMs', 'hostName', 'hostUid', 'notifyStudents', 'published', 'createdAt', 'updatedAt'
        ]) &&
        isValidMeetingSession(incoming());

      allow update: if isSignedIn() &&
        isValidId(meetingId) &&
        isAuthorizedMeetingHost() &&
        (isSuperAdmin() || existing().hostUid == request.auth.uid) &&
        isValidMeetingSession(incoming()) &&
        incoming().hostUid == existing().hostUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subject', 'description', 'meetUrl', 'scheduledDate', 'scheduledTime',
          'scheduledAtEpochMs', 'hostName', 'notifyStudents', 'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(meetingId) &&
        isAuthorizedMeetingHost() &&
        (isSuperAdmin() || existing().hostUid == request.auth.uid);
    }

    // --- 17. PROFESSOR DIRECTORY (Active Advisors Publicly Readable, Managed by Founder) ---
    match /professors/{professorId} {
      allow get: if isValidId(professorId) && (existing().active == true || isSuperAdmin());
      allow list: if existing().active == true || isSuperAdmin();

      allow create, update: if isSignedIn() &&
        isValidId(professorId) &&
        isSuperAdmin() &&
        incoming().keys().hasAll([
          'name', 'designation', 'qualification', 'subject', 'department', 'email',
          'specialization', 'avatarUrl', 'authorizedUid', 'canHostMeetings', 'active', 'displayOrder', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'name', 'designation', 'qualification', 'subject', 'department', 'email',
          'specialization', 'avatarUrl', 'authorizedUid', 'canHostMeetings', 'active', 'displayOrder', 'updatedAt'
        ]) &&
        isValidProfessorProfile(incoming());

      allow delete: if isValidId(professorId) && isSuperAdmin();
    }

    // --- 18. PROFESSOR ACCOUNT AUTHORIZATION REGISTRY (Founder / Admin Only) ---
    match /professorAccounts/{profUid} {
      allow get: if isSignedIn() && isValidId(profUid) && (request.auth.uid == profUid || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create, update: if isSignedIn() &&
        isValidId(profUid) &&
        isSuperAdmin() &&
        incoming().addedBy == request.auth.uid &&
        incoming().keys().hasAll(['professorId', 'email', 'canHostMeetings', 'active', 'addedBy', 'createdAt']) &&
        incoming().keys().hasOnly(['professorId', 'email', 'canHostMeetings', 'active', 'addedBy', 'createdAt']) &&
        isValidProfessorAccountLink(incoming());

      allow delete: if isValidId(profUid) && isSuperAdmin();
    }

    // --- 19. STUDENT CAREER GUIDANCE & FARMER ADVISOR EXPERT PRIVATE THREADS ---
    // Strictly Concerned Student/Farmer & Assigned Professor ONLY — NEVER Admin or Other Users
    match /doubtChats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && (
        existing().studentId == request.auth.uid ||
        isAssignedProfessorForThread(existing())
      );

      allow list: if isSignedIn() && (
        existing().studentId == request.auth.uid ||
        isAssignedProfessorForThread(existing())
      );

      allow create: if isSignedIn() &&
        isValidId(chatId) &&
        (
          chatId == incoming().professorId + '__' + incoming().studentId ||
          chatId == incoming().professorId + '__' + incoming().studentId + '__farmer'
        ) &&
        incoming().studentId == request.auth.uid &&
        incoming().keys().hasAll([
          'studentId', 'studentName', 'studentSemester', 'professorId', 'professorName',
          'professorEmail', 'professorUid', 'lastMessagePreview', 'lastSenderRole',
          'unreadForStudent', 'unreadForProfessor', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'studentId', 'studentName', 'studentSemester', 'professorId', 'professorName',
          'professorEmail', 'professorUid', 'lastMessagePreview', 'lastSenderRole',
          'unreadForStudent', 'unreadForProfessor', 'studentLastReadAt', 'professorLastReadAt',
          'serviceType', 'questionTitle', 'questionCategory', 'contactInfo',
          'emailDeliveryStatus', 'emailDeliveryError', 'emailDeliveryMessageId',
          'createdAt', 'updatedAt'
        ]) &&
        isValidDoubtChatThread(incoming());

      allow update: if isSignedIn() &&
        isValidId(chatId) &&
        isValidDoubtChatThread(incoming()) &&
        incoming().studentId == existing().studentId &&
        incoming().professorId == existing().professorId &&
        incoming().professorEmail == existing().professorEmail &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            existing().studentId == request.auth.uid &&
            incoming().professorUid == existing().professorUid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'studentName', 'studentSemester', 'lastMessagePreview', 'lastSenderRole',
              'unreadForStudent', 'unreadForProfessor', 'studentLastReadAt',
              'serviceType', 'questionTitle', 'questionCategory', 'contactInfo',
              'emailDeliveryStatus', 'emailDeliveryError', 'emailDeliveryMessageId',
              'updatedAt'
            ])
          ) ||
          (
            isAssignedProfessorForThread(existing()) &&
            (incoming().professorUid == existing().professorUid || incoming().professorUid == request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'professorName', 'professorUid', 'lastMessagePreview', 'lastSenderRole',
              'unreadForStudent', 'unreadForProfessor', 'professorLastReadAt', 'updatedAt'
            ])
          )
        );

      allow delete: if false;

      // Private Messages Subcollection (Strictly Concerned User & Assigned Professor ONLY)
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && (
          existing().studentId == request.auth.uid ||
          isAssignedProfessorForThread(existing())
        );

        allow list: if isSignedIn() && isValidId(chatId) && (
          existing().studentId == request.auth.uid ||
          isAssignedProfessorForThread(existing())
        );

        allow create: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          incoming().senderId == request.auth.uid &&
          incoming().readByRecipient == false &&
          incoming().keys().hasAll([
            'studentId', 'professorId', 'professorEmail', 'professorUid',
            'senderId', 'senderName', 'senderRole', 'text', 'hasImage', 'readByRecipient', 'createdAt'
          ]) &&
          incoming().keys().hasOnly([
            'studentId', 'professorId', 'professorEmail', 'professorUid',
            'senderId', 'senderName', 'senderRole', 'text', 'hasImage', 'imageBase64',
            'questionTitle', 'questionCategory', 'emailDeliveryStatus', 'emailDeliveryError',
            'readByRecipient', 'createdAt'
          ]) &&
          isValidDoubtMessage(incoming()) &&
          (
            exists(/databases/$(database)/documents/doubtChats/$(chatId)) ||
            existsAfter(/databases/$(database)/documents/doubtChats/$(chatId))
          ) &&
          incoming().studentId == getAfter(/databases/$(database)/documents/doubtChats/$(chatId)).data.studentId &&
          incoming().professorId == getAfter(/databases/$(database)/documents/doubtChats/$(chatId)).data.professorId &&
          incoming().professorEmail == getAfter(/databases/$(database)/documents/doubtChats/$(chatId)).data.professorEmail &&
          (
            (incoming().studentId == request.auth.uid && incoming().senderRole == 'STUDENT') ||
            (isAssignedProfessorForThread(getAfter(/databases/$(database)/documents/doubtChats/$(chatId)).data) && incoming().senderRole == 'PROFESSOR')
          );

        // Prevent editing message text/image — recipient marks readByRecipient = true; sender may update ONLY emailDeliveryStatus/Error
        allow update: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          isValidDoubtMessage(incoming()) &&
          (
            (
              existing().senderId != request.auth.uid &&
              (existing().studentId == request.auth.uid || isAssignedProfessorForThread(existing())) &&
              incoming().readByRecipient == true &&
              incoming().diff(existing()).affectedKeys().hasOnly(['readByRecipient'])
            ) ||
            (
              existing().senderId == request.auth.uid &&
              incoming().readByRecipient == existing().readByRecipient &&
              incoming().diff(existing()).affectedKeys().hasOnly(['emailDeliveryStatus', 'emailDeliveryError'])
            )
          );

        // Only original sender can delete own message
        allow delete: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          existing().senderId == request.auth.uid;
      }
    }

    // --- 20. VERIFIED CROP MARKET PRICES / MANDI RATES (Publicly Readable, Admin-Managed) ---
    match /marketPrices/{priceId} {
      allow get: if isValidId(priceId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(priceId) &&
        isValidMarketPrice(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll([
          'cropName', 'state', 'district', 'marketName', 'unit',
          'minPrice', 'maxPrice', 'modalPrice', 'reportDate', 'sourceName',
          'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'cropName', 'cropNameBn', 'state', 'district', 'marketName', 'unit',
          'minPrice', 'maxPrice', 'modalPrice', 'reportDate', 'sourceName', 'sourceUrl',
          'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(priceId) &&
        isValidMarketPrice(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'cropName', 'cropNameBn', 'state', 'district', 'marketName', 'unit',
          'minPrice', 'maxPrice', 'modalPrice', 'reportDate', 'sourceName', 'sourceUrl',
          'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(priceId) && isAdmin();
    }

    // =========================================================================
    // 21. FARMER FINANCIAL SUPPORT & RIGHTS — STRICTLY PRIVATE OWNER-ONLY RULES
    // Preserves financial history, blocks cross-farmer access & UID tampering
    // =========================================================================

    function isValidFarmerLandLease(data) {
      return data.farmerUid is string && data.farmerUid.size() >= 1 && data.farmerUid.size() <= 128 &&
        data.landownerName is string && data.landownerName.size() >= 2 && data.landownerName.size() <= 100 &&
        data.landownerContact is string && data.landownerContact.size() <= 60 &&
        data.village is string && data.village.size() <= 80 &&
        data.block is string && data.block.size() <= 80 &&
        data.district is string && data.district.size() <= 80 &&
        data.state is string && data.state.size() <= 60 &&
        data.landArea is number && data.landArea > 0 && data.landArea <= 100000 &&
        data.areaUnit is string && data.areaUnit.size() >= 1 && data.areaUnit.size() <= 24 &&
        data.startDate is string && data.startDate.size() >= 6 && data.startDate.size() <= 20 &&
        data.endDate is string && data.endDate.size() >= 6 && data.endDate.size() <= 20 &&
        data.leaseType in ['FIXED_RENT', 'CROP_SHARING'] &&
        data.totalLeaseAmount is number && data.totalLeaseAmount >= 0 && data.totalLeaseAmount <= 100000000 &&
        data.advancePayment is number && data.advancePayment >= 0 && data.advancePayment <= 100000000 &&
        data.paymentFrequency is string && data.paymentFrequency.size() >= 1 && data.paymentFrequency.size() <= 24 &&
        data.farmerSharePercent is number && data.farmerSharePercent >= 0 && data.farmerSharePercent <= 100 &&
        data.landownerSharePercent is number && data.landownerSharePercent >= 0 && data.landownerSharePercent <= 100 &&
        data.cropShareNote is string && data.cropShareNote.size() <= 250 &&
        data.isVerbalAgreement is bool &&
        data.verbalNotes is string && data.verbalNotes.size() <= 600 &&
        data.legalVerificationStatus == 'UNVERIFIED_USER_RECORD' &&
        data.paymentHistory is list && data.paymentHistory.size() <= 100 &&
        data.status in ['ACTIVE', 'COMPLETED', 'ARCHIVED'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFarmerLoanRecord(data) {
      return data.farmerUid is string && data.farmerUid.size() >= 1 && data.farmerUid.size() <= 128 &&
        data.lenderName is string && data.lenderName.size() >= 2 && data.lenderName.size() <= 100 &&
        data.lenderType in ['BANK_KCC', 'COOPERATIVE', 'SHG_MFI', 'PRIVATE_LENDER', 'RELATIVE_OTHER'] &&
        data.principalAmount is number && data.principalAmount > 0 && data.principalAmount <= 100000000 &&
        data.loanDate is string && data.loanDate.size() >= 6 && data.loanDate.size() <= 20 &&
        data.purpose is string && data.purpose.size() <= 160 &&
        data.interestRatePercent is number && data.interestRatePercent >= 0 && data.interestRatePercent <= 120 &&
        data.interestMethod in ['SIMPLE', 'COMPOUND'] &&
        data.compoundingFrequencyPerYear is int && data.compoundingFrequencyPerYear in [1, 2, 4, 12] &&
        data.repaymentPeriodMonths is int && data.repaymentPeriodMonths >= 1 && data.repaymentPeriodMonths <= 600 &&
        data.installmentFrequency is string && data.installmentFrequency.size() >= 1 && data.installmentFrequency.size() <= 24 &&
        data.scheduleType in ['FIXED', 'IRREGULAR', 'PARTIAL_FLEXIBLE'] &&
        data.nextDueDate is string && data.nextDueDate.size() <= 20 &&
        data.notes is string && data.notes.size() <= 500 &&
        (!('farmerCalculatedBalance' in data) || (data.farmerCalculatedBalance is number && data.farmerCalculatedBalance >= 0 && data.farmerCalculatedBalance <= 500000000)) &&
        (!('lenderClaimedAmount' in data) || (data.lenderClaimedAmount is number && data.lenderClaimedAmount >= 0 && data.lenderClaimedAmount <= 500000000)) &&
        (!('discrepancyNotes' in data) || (data.discrepancyNotes is string && data.discrepancyNotes.size() <= 500)) &&
        data.status in ['ACTIVE', 'CLOSED', 'DISPUTED', 'ARCHIVED'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFarmerLoanTransaction(data) {
      return data.farmerUid is string && data.farmerUid.size() >= 1 && data.farmerUid.size() <= 128 &&
        data.loanId is string && data.loanId.size() >= 1 && data.loanId.size() <= 128 &&
        data.lenderName is string && data.lenderName.size() <= 100 &&
        data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
        data.principalPortion is number && data.principalPortion >= 0 && data.principalPortion <= data.amount &&
        data.interestPortion is number && data.interestPortion >= 0 && data.interestPortion <= data.amount &&
        data.paymentDate is string && data.paymentDate.size() >= 6 && data.paymentDate.size() <= 20 &&
        data.paymentType in ['INSTALLMENT', 'PARTIAL', 'IRREGULAR', 'FULL_SETTLEMENT'] &&
        data.paymentMode is string && data.paymentMode.size() >= 1 && data.paymentMode.size() <= 30 &&
        data.receiptRef is string && data.receiptRef.size() <= 120 &&
        data.note is string && data.note.size() <= 300 &&
        data.status == 'RECORDED' &&
        isValidTimestamp(data.createdAt);
    }

    function isValidFarmerCropSale(data) {
      return data.farmerUid is string && data.farmerUid.size() >= 1 && data.farmerUid.size() <= 128 &&
        data.cropName is string && data.cropName.size() >= 2 && data.cropName.size() <= 80 &&
        data.cropVariety is string && data.cropVariety.size() <= 80 &&
        data.season in ['KHARIF', 'RABI', 'BORO_ZAID', 'ANNUAL'] &&
        data.landLabel is string && data.landLabel.size() <= 100 &&
        data.harvestDate is string && data.harvestDate.size() <= 20 &&
        data.sellingDate is string && data.sellingDate.size() >= 6 && data.sellingDate.size() <= 20 &&
        data.quantityHarvested is number && data.quantityHarvested >= 0 && data.quantityHarvested <= 1000000 &&
        data.quantitySold is number && data.quantitySold > 0 && data.quantitySold <= 1000000 &&
        data.priceUnit in ['QUINTAL', 'KG', 'TON'] &&
        data.sellingPricePerUnit is number && data.sellingPricePerUnit > 0 && data.sellingPricePerUnit <= 10000000 &&
        data.buyerName is string && data.buyerName.size() >= 2 && data.buyerName.size() <= 100 &&
        data.marketLocation is string && data.marketLocation.size() <= 100 &&
        data.transportCost is number && data.transportCost >= 0 && data.transportCost <= 10000000 &&
        data.marketCommission is number && data.marketCommission >= 0 && data.marketCommission <= 10000000 &&
        data.otherExpenses is number && data.otherExpenses >= 0 && data.otherExpenses <= 10000000 &&
        data.totalAmountReceived is number && data.totalAmountReceived >= 0 && data.totalAmountReceived <= 500000000 &&
        data.paymentStatus in ['PAID', 'PARTIAL', 'PENDING'] &&
        data.notes is string && data.notes.size() <= 400 &&
        data.status in ['ACTIVE', 'ARCHIVED'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFarmerExpense(data) {
      return data.farmerUid is string && data.farmerUid.size() >= 1 && data.farmerUid.size() <= 128 &&
        data.category in ['SEEDS', 'FERTILIZERS', 'PESTICIDES', 'LABOUR', 'IRRIGATION', 'MACHINERY', 'FUEL', 'LAND_LEASE', 'TRANSPORTATION', 'ELECTRICITY', 'OTHER', 'CUSTOM'] &&
        data.customCategory is string && data.customCategory.size() <= 60 &&
        data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
        data.expenseDate is string && data.expenseDate.size() >= 6 && data.expenseDate.size() <= 20 &&
        data.description is string && data.description.size() >= 2 && data.description.size() <= 300 &&
        data.cropName is string && data.cropName.size() <= 80 &&
        data.season in ['KHARIF', 'RABI', 'BORO_ZAID', 'ANNUAL'] &&
        data.landLabel is string && data.landLabel.size() <= 100 &&
        data.receiptDocumentId is string && data.receiptDocumentId.size() <= 128 &&
        data.status in ['ACTIVE', 'ARCHIVED'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFarmerComplaint(data) {
      return data.farmerUid is string && data.farmerUid.size() >= 1 && data.farmerUid.size() <= 128 &&
        data.category in [
          'LAND_LEASE_DISPUTE', 'UNCLEAR_RENTAL_AGREEMENT', 'LOAN_REPAYMENT_DISAGREEMENT',
          'INTEREST_CALCULATION_DISPUTE', 'CROP_PAYMENT_DELAY', 'CROP_SELLING_DISPUTE', 'GOVT_SCHEME_ISSUE'
        ] &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 1500 &&
        data.incidentDate is string && data.incidentDate.size() <= 20 &&
        data.contactPreference in ['WHATSAPP', 'PHONE', 'EMAIL', 'IN_APP_ONLY'] &&
        data.contactValue is string && data.contactValue.size() <= 80 &&
        data.supportingDocumentIds is list && data.supportingDocumentIds.size() <= 10 &&
        data.status in ['SUBMITTED', 'UNDER_REVIEW', 'ADDITIONAL_INFO_REQUIRED', 'RESOLVED', 'CLOSED'] &&
        data.supportNote is string && data.supportNote.size() <= 1000 &&
        data.reviewDisclaimer is string && data.reviewDisclaimer.size() <= 300 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFarmerDocument(data) {
      return data.farmerUid is string && data.farmerUid.size() >= 1 && data.farmerUid.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.docType in ['LEASE_AGREEMENT', 'PAYMENT_RECEIPT', 'LOAN_DOCUMENT', 'CROP_SALE_RECEIPT', 'EXPENSE_BILL', 'COMPLAINT_EVIDENCE', 'SCHEME_DOCUMENT'] &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 120 &&
        data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 60 &&
        data.fileSizeBytes is int && data.fileSizeBytes >= 1 && data.fileSizeBytes <= 5242880 &&
        data.relatedEntityType is string && data.relatedEntityType.size() <= 40 &&
        data.relatedEntityId is string && data.relatedEntityId.size() <= 128 &&
        data.docDate is string && data.docDate.size() <= 20 &&
        data.notes is string && data.notes.size() <= 300 &&
        data.storageMode in ['FIREBASE_STORAGE', 'FIRESTORE_INLINE_PRIVATE'] &&
        data.storagePath is string && data.storagePath.size() <= 300 &&
        data.downloadUrl is string && data.downloadUrl.size() <= 600 &&
        data.inlineDataUrl is string && data.inlineDataUrl.size() <= 360000 &&
        data.legalVerificationStatus == 'UNVERIFIED_USER_UPLOAD' &&
        data.status in ['ACTIVE', 'ARCHIVED'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFarmerFinanceAuditLog(data) {
      return data.farmerUid is string && data.farmerUid.size() >= 1 && data.farmerUid.size() <= 128 &&
        data.entityType is string && data.entityType.size() >= 2 && data.entityType.size() <= 40 &&
        data.entityId is string && data.entityId.size() <= 128 &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 40 &&
        data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 260 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidFarmerInterestComparison(data) {
      return data.farmerUid is string && data.farmerUid.size() >= 1 && data.farmerUid.size() <= 128 &&
        data.bankProductId is string && data.bankProductId.size() >= 2 && data.bankProductId.size() <= 60 &&
        data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 120 &&
        data.bankLoanType is string && data.bankLoanType.size() >= 2 && data.bankLoanType.size() <= 140 &&
        data.applySubvention is bool &&
        data.privateLenderName is string && data.privateLenderName.size() >= 1 && data.privateLenderName.size() <= 100 &&
        data.principalAmount is number && data.principalAmount >= 1000 && data.principalAmount <= 100000000 &&
        data.durationMonths is int && data.durationMonths >= 1 && data.durationMonths <= 360 &&
        data.privateInterestRate is number && data.privateInterestRate >= 0 && data.privateInterestRate <= 200 &&
        data.privateRatePeriod in ['MONTHLY', 'ANNUAL'] &&
        data.privateInterestMethod in ['SIMPLE', 'COMPOUND'] &&
        data.privateCompoundingPerYear is int && data.privateCompoundingPerYear in [1, 2, 4, 12] &&
        data.repaymentSchedule in ['MONTHLY', 'QUARTERLY', 'YEARLY', 'LUMP_SUM'] &&
        data.additionalFees is number && data.additionalFees >= 0 && data.additionalFees <= 10000000 &&
        data.amountAlreadyRepaid is number && data.amountAlreadyRepaid >= 0 && data.amountAlreadyRepaid <= 100000000 &&
        data.bankTotalInterest is number && data.bankTotalInterest >= 0 && data.bankTotalInterest <= 500000000 &&
        data.bankTotalRepayment is number && data.bankTotalRepayment >= 0 && data.bankTotalRepayment <= 600000000 &&
        data.bankEffectiveAnnualCostPercent is number && data.bankEffectiveAnnualCostPercent >= 0 && data.bankEffectiveAnnualCostPercent <= 1000 &&
        data.privateTotalBorrowingCost is number && data.privateTotalBorrowingCost >= 0 && data.privateTotalBorrowingCost <= 500000000 &&
        data.privateTotalRepayment is number && data.privateTotalRepayment >= 0 && data.privateTotalRepayment <= 600000000 &&
        data.privateEffectiveAnnualCostPercent is number && data.privateEffectiveAnnualCostPercent >= 0 && data.privateEffectiveAnnualCostPercent <= 10000 &&
        data.interestCostDifference is number && data.interestCostDifference >= -500000000 && data.interestCostDifference <= 500000000 &&
        data.bankRateVerifiedDate is string && data.bankRateVerifiedDate.size() >= 6 && data.bankRateVerifiedDate.size() <= 20 &&
        data.notes is string && data.notes.size() <= 300 &&
        isValidTimestamp(data.createdAt);
    }

    match /farmer_land_leases/{leaseId} {
      allow get: if isSignedIn() && isValidId(leaseId) && existing().farmerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().farmerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(leaseId) &&
        incoming().farmerUid == request.auth.uid &&
        incoming().keys().hasAll([
          'farmerUid', 'landownerName', 'landownerContact', 'village', 'block', 'district', 'state',
          'landArea', 'areaUnit', 'startDate', 'endDate', 'leaseType', 'totalLeaseAmount', 'advancePayment',
          'paymentFrequency', 'farmerSharePercent', 'landownerSharePercent', 'cropShareNote',
          'isVerbalAgreement', 'verbalNotes', 'legalVerificationStatus', 'paymentHistory', 'status', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'farmerUid', 'landownerName', 'landownerContact', 'village', 'block', 'district', 'state',
          'landArea', 'areaUnit', 'startDate', 'endDate', 'leaseType', 'totalLeaseAmount', 'advancePayment',
          'paymentFrequency', 'farmerSharePercent', 'landownerSharePercent', 'cropShareNote',
          'isVerbalAgreement', 'verbalNotes', 'legalVerificationStatus', 'paymentHistory', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidFarmerLandLease(incoming());

      allow update: if isSignedIn() &&
        isValidId(leaseId) &&
        existing().farmerUid == request.auth.uid &&
        incoming().farmerUid == existing().farmerUid &&
        incoming().createdAt == existing().createdAt &&
        isValidFarmerLandLease(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'landownerName', 'landownerContact', 'village', 'block', 'district', 'state',
          'landArea', 'areaUnit', 'startDate', 'endDate', 'leaseType', 'totalLeaseAmount', 'advancePayment',
          'paymentFrequency', 'farmerSharePercent', 'landownerSharePercent', 'cropShareNote',
          'isVerbalAgreement', 'verbalNotes', 'paymentHistory', 'status', 'updatedAt'
        ]);

      // Preserve financial history — soft-archive via status = 'ARCHIVED' instead of hard delete
      allow delete: if false;
    }

    match /farmer_loan_records/{loanId} {
      allow get: if isSignedIn() && isValidId(loanId) && existing().farmerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().farmerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(loanId) &&
        incoming().farmerUid == request.auth.uid &&
        incoming().keys().hasAll([
          'farmerUid', 'lenderName', 'lenderType', 'principalAmount', 'loanDate', 'purpose',
          'interestRatePercent', 'interestMethod', 'compoundingFrequencyPerYear', 'repaymentPeriodMonths',
          'installmentFrequency', 'scheduleType', 'nextDueDate', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'farmerUid', 'lenderName', 'lenderType', 'principalAmount', 'loanDate', 'purpose',
          'interestRatePercent', 'interestMethod', 'compoundingFrequencyPerYear', 'repaymentPeriodMonths',
          'installmentFrequency', 'scheduleType', 'nextDueDate', 'notes',
          'farmerCalculatedBalance', 'lenderClaimedAmount', 'discrepancyNotes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidFarmerLoanRecord(incoming());

      allow update: if isSignedIn() &&
        isValidId(loanId) &&
        existing().farmerUid == request.auth.uid &&
        incoming().farmerUid == existing().farmerUid &&
        incoming().createdAt == existing().createdAt &&
        isValidFarmerLoanRecord(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'lenderName', 'lenderType', 'principalAmount', 'loanDate', 'purpose',
          'interestRatePercent', 'interestMethod', 'compoundingFrequencyPerYear', 'repaymentPeriodMonths',
          'installmentFrequency', 'scheduleType', 'nextDueDate', 'notes',
          'farmerCalculatedBalance', 'lenderClaimedAmount', 'discrepancyNotes', 'status', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // Immutable Loan Repayment History (Append-Only — prevents tampering or silent deletion)
    match /farmer_loan_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && existing().farmerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().farmerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(txId) &&
        incoming().farmerUid == request.auth.uid &&
        incoming().keys().hasAll([
          'farmerUid', 'loanId', 'lenderName', 'amount', 'principalPortion', 'interestPortion',
          'paymentDate', 'paymentType', 'paymentMode', 'receiptRef', 'note', 'status', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'farmerUid', 'loanId', 'lenderName', 'amount', 'principalPortion', 'interestPortion',
          'paymentDate', 'paymentType', 'paymentMode', 'receiptRef', 'note', 'status', 'createdAt'
        ]) &&
        isValidFarmerLoanTransaction(incoming());

      allow update: if false;
      allow delete: if false;
    }

    match /farmer_crop_sales/{saleId} {
      allow get: if isSignedIn() && isValidId(saleId) && existing().farmerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().farmerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(saleId) &&
        incoming().farmerUid == request.auth.uid &&
        incoming().keys().hasAll([
          'farmerUid', 'cropName', 'cropVariety', 'season', 'landLabel', 'harvestDate', 'sellingDate',
          'quantityHarvested', 'quantitySold', 'priceUnit', 'sellingPricePerUnit', 'buyerName',
          'marketLocation', 'transportCost', 'marketCommission', 'otherExpenses', 'totalAmountReceived',
          'paymentStatus', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'farmerUid', 'cropName', 'cropVariety', 'season', 'landLabel', 'harvestDate', 'sellingDate',
          'quantityHarvested', 'quantitySold', 'priceUnit', 'sellingPricePerUnit', 'buyerName',
          'marketLocation', 'transportCost', 'marketCommission', 'otherExpenses', 'totalAmountReceived',
          'paymentStatus', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidFarmerCropSale(incoming());

      allow update: if isSignedIn() &&
        isValidId(saleId) &&
        existing().farmerUid == request.auth.uid &&
        incoming().farmerUid == existing().farmerUid &&
        incoming().createdAt == existing().createdAt &&
        isValidFarmerCropSale(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'cropName', 'cropVariety', 'season', 'landLabel', 'harvestDate', 'sellingDate',
          'quantityHarvested', 'quantitySold', 'priceUnit', 'sellingPricePerUnit', 'buyerName',
          'marketLocation', 'transportCost', 'marketCommission', 'otherExpenses', 'totalAmountReceived',
          'paymentStatus', 'notes', 'status', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /farmer_expenses/{expenseId} {
      allow get: if isSignedIn() && isValidId(expenseId) && existing().farmerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().farmerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(expenseId) &&
        incoming().farmerUid == request.auth.uid &&
        incoming().keys().hasAll([
          'farmerUid', 'category', 'customCategory', 'amount', 'expenseDate',
          'description', 'cropName', 'season', 'landLabel', 'receiptDocumentId', 'status', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'farmerUid', 'category', 'customCategory', 'amount', 'expenseDate',
          'description', 'cropName', 'season', 'landLabel', 'receiptDocumentId', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidFarmerExpense(incoming());

      allow update: if isSignedIn() &&
        isValidId(expenseId) &&
        existing().farmerUid == request.auth.uid &&
        incoming().farmerUid == existing().farmerUid &&
        incoming().createdAt == existing().createdAt &&
        isValidFarmerExpense(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'category', 'customCategory', 'amount', 'expenseDate',
          'description', 'cropName', 'season', 'landLabel', 'receiptDocumentId', 'status', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /farmer_complaints/{complaintId} {
      allow get: if isSignedIn() && isValidId(complaintId) && (existing().farmerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().farmerUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(complaintId) &&
        incoming().farmerUid == request.auth.uid &&
        incoming().status == 'SUBMITTED' &&
        incoming().supportNote == '' &&
        incoming().keys().hasAll([
          'farmerUid', 'category', 'description', 'incidentDate', 'contactPreference', 'contactValue',
          'supportingDocumentIds', 'status', 'supportNote', 'reviewDisclaimer', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'farmerUid', 'category', 'description', 'incidentDate', 'contactPreference', 'contactValue',
          'supportingDocumentIds', 'status', 'supportNote', 'reviewDisclaimer', 'createdAt', 'updatedAt'
        ]) &&
        isValidFarmerComplaint(incoming());

      allow update: if isSignedIn() &&
        isValidId(complaintId) &&
        isValidFarmerComplaint(incoming()) &&
        incoming().farmerUid == existing().farmerUid &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'supportNote', 'updatedAt'])
          ) ||
          (
            existing().farmerUid == request.auth.uid &&
            incoming().status == existing().status &&
            incoming().supportNote == existing().supportNote &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'description', 'contactPreference', 'contactValue', 'supportingDocumentIds', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    match /farmer_documents/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && existing().farmerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().farmerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(docId) &&
        incoming().farmerUid == request.auth.uid &&
        incoming().keys().hasAll([
          'farmerUid', 'title', 'docType', 'fileName', 'mimeType', 'fileSizeBytes',
          'relatedEntityType', 'relatedEntityId', 'docDate', 'notes',
          'storageMode', 'storagePath', 'downloadUrl', 'inlineDataUrl',
          'legalVerificationStatus', 'status', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'farmerUid', 'title', 'docType', 'fileName', 'mimeType', 'fileSizeBytes',
          'relatedEntityType', 'relatedEntityId', 'docDate', 'notes',
          'storageMode', 'storagePath', 'downloadUrl', 'inlineDataUrl',
          'legalVerificationStatus', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidFarmerDocument(incoming());

      allow update: if isSignedIn() &&
        isValidId(docId) &&
        existing().farmerUid == request.auth.uid &&
        incoming().farmerUid == existing().farmerUid &&
        incoming().createdAt == existing().createdAt &&
        isValidFarmerDocument(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes', 'status', 'updatedAt']);

      allow delete: if false;
    }

    // Immutable Farmer Financial Audit Trail (Append-Only)
    match /farmer_finance_audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && existing().farmerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().farmerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(logId) &&
        incoming().farmerUid == request.auth.uid &&
        incoming().keys().hasAll(['farmerUid', 'entityType', 'entityId', 'action', 'summary', 'createdAt']) &&
        incoming().keys().hasOnly(['farmerUid', 'entityType', 'entityId', 'action', 'summary', 'createdAt']) &&
        isValidFarmerFinanceAuditLog(incoming());

      allow update: if false;
      allow delete: if false;
    }

    // Private Farmer Bank vs Private Lender Interest Rate Comparisons (Strictly Owner-Only, Never Public or Admin)
    match /farmer_interest_comparisons/{compId} {
      allow get: if isSignedIn() && isValidId(compId) && existing().farmerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().farmerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(compId) &&
        incoming().farmerUid == request.auth.uid &&
        incoming().keys().hasAll([
          'farmerUid', 'bankProductId', 'bankName', 'bankLoanType', 'applySubvention',
          'privateLenderName', 'principalAmount', 'durationMonths', 'privateInterestRate',
          'privateRatePeriod', 'privateInterestMethod', 'privateCompoundingPerYear',
          'repaymentSchedule', 'additionalFees', 'amountAlreadyRepaid',
          'bankTotalInterest', 'bankTotalRepayment', 'bankEffectiveAnnualCostPercent',
          'privateTotalBorrowingCost', 'privateTotalRepayment', 'privateEffectiveAnnualCostPercent',
          'interestCostDifference', 'bankRateVerifiedDate', 'notes', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'farmerUid', 'bankProductId', 'bankName', 'bankLoanType', 'applySubvention',
          'privateLenderName', 'principalAmount', 'durationMonths', 'privateInterestRate',
          'privateRatePeriod', 'privateInterestMethod', 'privateCompoundingPerYear',
          'repaymentSchedule', 'additionalFees', 'amountAlreadyRepaid',
          'bankTotalInterest', 'bankTotalRepayment', 'bankEffectiveAnnualCostPercent',
          'privateTotalBorrowingCost', 'privateTotalRepayment', 'privateEffectiveAnnualCostPercent',
          'interestCostDifference', 'bankRateVerifiedDate', 'notes', 'createdAt'
        ]) &&
        isValidFarmerInterestComparison(incoming());

      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // PHASE 5: AGRICULTURE GOVERNMENT SCHEMES & FARMER BENEFITS DIRECTORY
    // Public read ONLY for published == true; Admin read/write strictly via isAdmin().
    // Append-only update history with source URLs restricted to Admins only.
    // =========================================================================

    function isValidSchemeUrlOrEmpty(url) {
      return url is string && (url == '' || (url.size() >= 8 && url.size() <= 400 && url.matches('^https?://.*')));
    }

    function isValidAgricultureSchemeCore(data) {
      return data.schemeSlug is string && data.schemeSlug.size() >= 2 && data.schemeSlug.size() <= 80 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 200 &&
        data.nameBn is string && data.nameBn.size() <= 220 &&
        data.category in [
          'FINANCIAL_ASSISTANCE', 'CROP_INSURANCE', 'AGRI_LOANS_CREDIT', 'KCC',
          'IRRIGATION_WATER', 'SOIL_HEALTH', 'SEEDS_FERTILIZERS', 'AGRI_MACHINERY',
          'ORGANIC_NATURAL', 'HORTICULTURE', 'FLORICULTURE', 'DAIRY_FARMING',
          'POULTRY_FARMING', 'FISHERIES_AQUACULTURE', 'LIVESTOCK_DEV', 'WOMEN_FARMER',
          'FPO', 'AGRI_MARKETING', 'STORAGE_COLD_CHAIN', 'TRAINING_SKILL',
          'AGRI_ENTREPRENEURSHIP', 'RURAL_LIVELIHOOD', 'OTHER_AGRI'
        ] &&
        data.secondaryCategories is list && data.secondaryCategories.size() <= 5 &&
        data.womenFarmerEligible is bool &&
        data.govtLevel in ['CENTRAL', 'STATE', 'DISTRICT'] &&
        data.applicableState is string && data.applicableState.size() >= 2 && data.applicableState.size() <= 80 &&
        data.applicableRegion is string && data.applicableRegion.size() <= 220 &&
        data.applicableRegionBn is string && data.applicableRegionBn.size() <= 240 &&
        data.applicableDistricts is list && data.applicableDistricts.size() <= 60 &&
        data.purpose is string && data.purpose.size() >= 2 && data.purpose.size() <= 1200 &&
        data.purposeBn is string && data.purposeBn.size() <= 1400 &&
        data.benefits is string && data.benefits.size() >= 2 && data.benefits.size() <= 1500 &&
        data.benefitsBn is string && data.benefitsBn.size() <= 1700;
    }

    function isValidAgricultureSchemeEligibility(data) {
      return data.eligibleCategories is string && data.eligibleCategories.size() <= 600 &&
        data.eligibleCategoriesBn is string && data.eligibleCategoriesBn.size() <= 700 &&
        data.landholding is string && data.landholding.size() <= 500 &&
        data.landholdingBn is string && data.landholdingBn.size() <= 600 &&
        data.tenantFarmers is string && data.tenantFarmers.size() <= 500 &&
        data.tenantFarmersBn is string && data.tenantFarmersBn.size() <= 600 &&
        data.womenFarmers is string && data.womenFarmers.size() <= 500 &&
        data.womenFarmersBn is string && data.womenFarmersBn.size() <= 600 &&
        data.ageLimit is string && data.ageLimit.size() <= 240 &&
        data.ageLimitBn is string && data.ageLimitBn.size() <= 260 &&
        data.incomeLimit is string && data.incomeLimit.size() <= 400 &&
        data.incomeLimitBn is string && data.incomeLimitBn.size() <= 450 &&
        data.residency is string && data.residency.size() <= 400 &&
        data.residencyBn is string && data.residencyBn.size() <= 450 &&
        data.whoCanApply is list && data.whoCanApply.size() <= 20 &&
        data.whoCanApplyBn is list && data.whoCanApplyBn.size() <= 20 &&
        data.whoCannotApply is list && data.whoCannotApply.size() <= 20 &&
        data.whoCannotApplyBn is list && data.whoCannotApplyBn.size() <= 20 &&
        data.requiredDocuments is list && data.requiredDocuments.size() <= 20;
    }

    function isValidAgricultureSchemeMeta(data) {
      return data.applicationProcess is string && data.applicationProcess.size() <= 1500 &&
        data.applicationProcessBn is string && data.applicationProcessBn.size() <= 1700 &&
        isValidSchemeUrlOrEmpty(data.officialPortalUrl) &&
        data.offlineProcess is string && data.offlineProcess.size() <= 1200 &&
        data.offlineProcessBn is string && data.offlineProcessBn.size() <= 1400 &&
        data.department is string && data.department.size() >= 2 && data.department.size() <= 200 &&
        data.departmentBn is string && data.departmentBn.size() <= 220 &&
        data.helpline is string && data.helpline.size() <= 180 &&
        data.helplineBn is string && data.helplineBn.size() <= 200 &&
        data.helplineTel is string && data.helplineTel.size() <= 30 &&
        data.deadline is string && data.deadline.size() <= 240 &&
        data.deadlineBn is string && data.deadlineBn.size() <= 260 &&
        data.status in ['ACTIVE', 'SEASONAL', 'UNVERIFIED', 'OUTDATED', 'CLOSED'] &&
        data.lastVerifiedDate is string && data.lastVerifiedDate.size() <= 30 &&
        data.officialSourceUrl is string && data.officialSourceUrl.size() >= 8 && data.officialSourceUrl.size() <= 400 &&
        data.officialSourceUrl.matches('^https?://.*') &&
        data.officialSourceName is string && data.officialSourceName.size() >= 2 && data.officialSourceName.size() <= 180 &&
        data.lastUpdateNote is string && data.lastUpdateNote.size() <= 400 &&
        data.published is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAgricultureScheme(data) {
      return isValidAgricultureSchemeCore(data) &&
        isValidAgricultureSchemeEligibility(data) &&
        isValidAgricultureSchemeMeta(data);
    }

    function isValidAgricultureSchemeHistory(data) {
      return data.schemeId is string && data.schemeId.size() >= 1 && data.schemeId.size() <= 128 &&
        data.schemeName is string && data.schemeName.size() >= 2 && data.schemeName.size() <= 200 &&
        data.action in ['CREATE', 'UPDATE', 'PUBLISH', 'UNPUBLISH', 'MARK_OUTDATED', 'STATUS_CHANGE', 'DELETE'] &&
        data.statusAfter in ['ACTIVE', 'SEASONAL', 'UNVERIFIED', 'OUTDATED', 'CLOSED', 'DELETED'] &&
        data.lastVerifiedDate is string && data.lastVerifiedDate.size() <= 30 &&
        isValidSchemeUrlOrEmpty(data.officialSourceUrl) &&
        data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 400 &&
        data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
        data.actorEmail is string && data.actorEmail.size() <= 120 &&
        isValidTimestamp(data.createdAt);
    }

    match /agricultureSchemes/{schemeId} {
      allow get: if isValidId(schemeId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(schemeId) &&
        isAdmin() &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll([
          'schemeSlug', 'name', 'nameBn', 'category', 'secondaryCategories', 'womenFarmerEligible',
          'govtLevel', 'applicableState', 'applicableRegion', 'applicableRegionBn', 'applicableDistricts',
          'purpose', 'purposeBn', 'benefits', 'benefitsBn',
          'eligibleCategories', 'eligibleCategoriesBn', 'landholding', 'landholdingBn',
          'tenantFarmers', 'tenantFarmersBn', 'womenFarmers', 'womenFarmersBn',
          'ageLimit', 'ageLimitBn', 'incomeLimit', 'incomeLimitBn', 'residency', 'residencyBn',
          'whoCanApply', 'whoCanApplyBn', 'whoCannotApply', 'whoCannotApplyBn', 'requiredDocuments',
          'applicationProcess', 'applicationProcessBn', 'officialPortalUrl', 'offlineProcess', 'offlineProcessBn',
          'department', 'departmentBn', 'helpline', 'helplineBn', 'helplineTel', 'deadline', 'deadlineBn',
          'status', 'lastVerifiedDate', 'officialSourceUrl', 'officialSourceName', 'lastUpdateNote',
          'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'schemeSlug', 'name', 'nameBn', 'category', 'secondaryCategories', 'womenFarmerEligible',
          'govtLevel', 'applicableState', 'applicableRegion', 'applicableRegionBn', 'applicableDistricts',
          'purpose', 'purposeBn', 'benefits', 'benefitsBn',
          'eligibleCategories', 'eligibleCategoriesBn', 'landholding', 'landholdingBn',
          'tenantFarmers', 'tenantFarmersBn', 'womenFarmers', 'womenFarmersBn',
          'ageLimit', 'ageLimitBn', 'incomeLimit', 'incomeLimitBn', 'residency', 'residencyBn',
          'whoCanApply', 'whoCanApplyBn', 'whoCannotApply', 'whoCannotApplyBn', 'requiredDocuments',
          'applicationProcess', 'applicationProcessBn', 'officialPortalUrl', 'offlineProcess', 'offlineProcessBn',
          'department', 'departmentBn', 'helpline', 'helplineBn', 'helplineTel', 'deadline', 'deadlineBn',
          'status', 'lastVerifiedDate', 'officialSourceUrl', 'officialSourceName', 'lastUpdateNote',
          'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidAgricultureScheme(incoming());

      allow update: if isSignedIn() &&
        isValidId(schemeId) &&
        isAdmin() &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isValidAgricultureScheme(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'schemeSlug', 'name', 'nameBn', 'category', 'secondaryCategories', 'womenFarmerEligible',
          'govtLevel', 'applicableState', 'applicableRegion', 'applicableRegionBn', 'applicableDistricts',
          'purpose', 'purposeBn', 'benefits', 'benefitsBn',
          'eligibleCategories', 'eligibleCategoriesBn', 'landholding', 'landholdingBn',
          'tenantFarmers', 'tenantFarmersBn', 'womenFarmers', 'womenFarmersBn',
          'ageLimit', 'ageLimitBn', 'incomeLimit', 'incomeLimitBn', 'residency', 'residencyBn',
          'whoCanApply', 'whoCanApplyBn', 'whoCannotApply', 'whoCannotApplyBn', 'requiredDocuments',
          'applicationProcess', 'applicationProcessBn', 'officialPortalUrl', 'offlineProcess', 'offlineProcessBn',
          'department', 'departmentBn', 'helpline', 'helplineBn', 'helplineTel', 'deadline', 'deadlineBn',
          'status', 'lastVerifiedDate', 'officialSourceUrl', 'officialSourceName', 'lastUpdateNote',
          'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(schemeId) && isAdmin();
    }

    // Admin-Only Append-Only Scheme Update History & Source Audit Trail
    match /agricultureSchemeHistory/{historyId} {
      allow get: if isValidId(historyId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
        isValidId(historyId) &&
        isAdmin() &&
        incoming().actorUid == request.auth.uid &&
        incoming().keys().hasAll([
          'schemeId', 'schemeName', 'action', 'statusAfter',
          'lastVerifiedDate', 'officialSourceUrl', 'summary', 'actorUid', 'actorEmail', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'schemeId', 'schemeName', 'action', 'statusAfter',
          'lastVerifiedDate', 'officialSourceUrl', 'summary', 'actorUid', 'actorEmail', 'createdAt'
        ]) &&
        isValidAgricultureSchemeHistory(incoming());

      allow update: if false;
      allow delete: if false;
    }

    // --- PHASE 7: UNIVERSITY-WISE OFFICIAL SYLLABI (Public Read when Published, Admin-Only Write) ---
    match /syllabi/{syllabusId} {
      allow get: if isValidId(syllabusId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(syllabusId) &&
        isAdmin() &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll([
          'university', 'universityShort', 'course', 'semester', 'subject',
          'topics', 'publicationYear', 'sourceUrl', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'university', 'universityShort', 'course', 'semester', 'subject', 'subjectKey',
          'topics', 'publicationYear', 'academicSession', 'sourceUrl', 'pdfUrl', 'downloadPermitted',
          'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidUniversitySyllabus(incoming());

      allow update: if isSignedIn() &&
        isValidId(syllabusId) &&
        isAdmin() &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isValidUniversitySyllabus(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'university', 'universityShort', 'course', 'semester', 'subject', 'subjectKey',
          'topics', 'publicationYear', 'academicSession', 'sourceUrl', 'pdfUrl', 'downloadPermitted',
          'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(syllabusId) && isAdmin();
    }

    // --- PHASE 7 & PHASE 3: AGRICULTURAL LEARNING RESOURCES & AUTO-DISCOVERY REVIEW QUEUE ---
    match /discoveredStudyResources/{resourceId} {
      allow get: if isValidId(resourceId) && (existing().reviewStatus == 'APPROVED_PUBLISHED' || isAdmin());
      allow list: if existing().reviewStatus == 'APPROVED_PUBLISHED' || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(resourceId) &&
        isAdmin() &&
        incoming().keys().hasAll([
          'title', 'sourceWebsite', 'publicationDate', 'subjectKey', 'topic',
          'category', 'sourceUrl', 'dedupeKey', 'discoveryMethod', 'reviewStatus',
          'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'sourceWebsite', 'publicationDate', 'subjectKey', 'topic',
          'category', 'sourceUrl', 'dedupeKey', 'discoveryMethod', 'reviewStatus',
          'summary', 'language', 'thumbnailUrl', 'resourceOrigin', 'reviewedBy',
          'createdAt', 'updatedAt'
        ]) &&
        isValidDiscoveredStudyResource(incoming());

      allow update: if isSignedIn() &&
        isValidId(resourceId) &&
        isAdmin() &&
        incoming().createdAt == existing().createdAt &&
        isValidDiscoveredStudyResource(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'sourceWebsite', 'publicationDate', 'subjectKey', 'topic',
          'category', 'sourceUrl', 'reviewStatus', 'summary', 'language', 'thumbnailUrl',
          'resourceOrigin', 'reviewedBy', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(resourceId) && isAdmin();
    }

    // --- PHASE 3: ADMIN-MANAGED PRACTICE TESTS & MOCK TESTS (Public Read when Published, Admin-Only Write) ---
    match /mockTests/{testId} {
      allow get: if isValidId(testId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(testId) &&
        isAdmin() &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll([
          'title', 'testType', 'examCategory', 'subjectKey', 'semester', 'difficulty',
          'durationMinutes', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'testType', 'examCategory', 'subjectKey', 'semester', 'difficulty',
          'durationMinutes', 'description', 'questionIds', 'onlyOfficialPyq',
          'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidMockTest(incoming());

      allow update: if isSignedIn() &&
        isValidId(testId) &&
        isAdmin() &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isValidMockTest(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'testType', 'examCategory', 'subjectKey', 'semester', 'difficulty',
          'durationMinutes', 'description', 'questionIds', 'onlyOfficialPyq',
          'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(testId) && isAdmin();
    }

    // --- PHASE 4: WOMEN FARMER YOUTUBE LEARNING LIBRARY (Public Read when Published, Admin-Only Write) ---
    match /womenVideos/{videoId} {
      allow get: if isValidId(videoId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(videoId) &&
        isAdmin() &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll([
          'title', 'category', 'language', 'youtubeUrl', 'videoId', 'audience',
          'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'titleBn', 'description', 'descriptionBn', 'category', 'language',
          'youtubeUrl', 'videoId', 'thumbnailUrl', 'sourceName', 'audience',
          'lastVerifiedDate', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidWomenVideo(incoming());

      allow update: if isSignedIn() &&
        isValidId(videoId) &&
        isAdmin() &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isValidWomenVideo(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'titleBn', 'description', 'descriptionBn', 'category', 'language',
          'youtubeUrl', 'videoId', 'thumbnailUrl', 'sourceName', 'audience',
          'lastVerifiedDate', 'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(videoId) && isAdmin();
    }

    // --- PHASE 4: WOMEN FARMER LEARNING CENTRE GUIDES (Public Read when Published, Admin-Only Write) ---
    match /womenLearningResources/{resourceId} {
      allow get: if isValidId(resourceId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(resourceId) &&
        isAdmin() &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll([
          'pillar', 'title', 'summary', 'officialSourceName', 'officialSourceUrl',
          'lastVerifiedDate', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'pillar', 'title', 'titleBn', 'summary', 'summaryBn', 'keyPointsEn', 'keyPointsBn',
          'officialSourceName', 'officialSourceUrl', 'lastVerifiedDate', 'published',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidWomenLearningResource(incoming());

      allow update: if isSignedIn() &&
        isValidId(resourceId) &&
        isAdmin() &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isValidWomenLearningResource(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'pillar', 'title', 'titleBn', 'summary', 'summaryBn', 'keyPointsEn', 'keyPointsBn',
          'officialSourceName', 'officialSourceUrl', 'lastVerifiedDate', 'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(resourceId) && isAdmin();
    }

    // --- PHASE 4: AUTOMATIC SCHEME DISCOVERY ADMIN REVIEW QUEUE (Admin Review Before Publication) ---
    match /womenSchemeDiscoveryQueue/{itemId} {
      allow get: if isValidId(itemId) && (existing().reviewStatus == 'APPROVED_PUBLISHED' || isAdmin());
      allow list: if existing().reviewStatus == 'APPROVED_PUBLISHED' || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(itemId) &&
        isAdmin() &&
        incoming().keys().hasAll([
          'title', 'sourceName', 'officialSourceUrl', 'publicationDate',
          'suggestedCategory', 'suggestedGovtLevel', 'suggestedState',
          'womenRelevanceTag', 'discoveryMethod', 'reviewStatus', 'dedupeKey',
          'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'sourceName', 'officialSourceUrl', 'publicationDate',
          'suggestedCategory', 'suggestedGovtLevel', 'suggestedState',
          'womenRelevanceTag', 'discoveryMethod', 'reviewStatus', 'dedupeKey',
          'summary', 'reviewedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidWomenSchemeDiscovery(incoming());

      allow update: if isSignedIn() &&
        isValidId(itemId) &&
        isAdmin() &&
        incoming().createdAt == existing().createdAt &&
        isValidWomenSchemeDiscovery(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'sourceName', 'officialSourceUrl', 'publicationDate',
          'suggestedCategory', 'suggestedGovtLevel', 'suggestedState',
          'womenRelevanceTag', 'reviewStatus', 'summary', 'reviewedBy', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(itemId) && isAdmin();
    }

    // --- PHASE 5: WOMEN FARMER NEARBY SERVICES DIRECTORY (Public Verified Only, Contributor Pending Queue, Admin Verify) ---
    match /nearbyServiceListings/{listingId} {
      allow get: if isValidId(listingId) && (
        (existing().verificationStatus == 'ADMIN_VERIFIED' && existing().published == true) ||
        isAdmin() ||
        (isSignedIn() && existing().submittedBy == request.auth.uid)
      );
      allow list: if (existing().verificationStatus == 'ADMIN_VERIFIED' && existing().published == true) ||
        isAdmin() ||
        (isSignedIn() && existing().submittedBy == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(listingId) &&
        incoming().submittedBy == request.auth.uid &&
        incoming().keys().hasAll([
          'name', 'category', 'address', 'district', 'state', 'pinCode',
          'verificationStatus', 'published', 'submittedBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'name', 'nameBn', 'category', 'address', 'area', 'district', 'state', 'pinCode',
          'phone', 'notes', 'lat', 'lng', 'verificationStatus', 'approvalStatus', 'published',
          'submittedBy', 'submittedByName', 'verifiedBy', 'lastVerifiedDate',
          'createdAt', 'updatedAt'
        ]) &&
        isValidNearbyServiceListing(incoming()) &&
        (
          isAdmin() ||
          (incoming().verificationStatus == 'PENDING_REVIEW' && incoming().published == false &&
           (!('approvalStatus' in incoming()) || incoming().approvalStatus == 'PENDING'))
        );

      allow update: if isSignedIn() &&
        isValidId(listingId) &&
        isAdmin() &&
        incoming().submittedBy == existing().submittedBy &&
        incoming().createdAt == existing().createdAt &&
        isValidNearbyServiceListing(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'nameBn', 'category', 'address', 'area', 'district', 'state', 'pinCode',
          'phone', 'notes', 'lat', 'lng', 'verificationStatus', 'approvalStatus', 'published',
          'verifiedBy', 'lastVerifiedDate', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(listingId) && isAdmin();
    }

    // --- PHASE 5: WOMEN FARMER SHG DIRECTORY (Public Verified Only, Contributor Pending Queue, Admin Verify) ---
    match /shgDirectoryListings/{shgId} {
      allow get: if isValidId(shgId) && (
        (existing().verificationStatus == 'ADMIN_VERIFIED' && existing().published == true) ||
        isAdmin() ||
        (isSignedIn() && existing().submittedBy == request.auth.uid)
      );
      allow list: if (existing().verificationStatus == 'ADMIN_VERIFIED' && existing().published == true) ||
        isAdmin() ||
        (isSignedIn() && existing().submittedBy == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(shgId) &&
        incoming().submittedBy == request.auth.uid &&
        incoming().keys().hasAll([
          'shgName', 'area', 'district', 'state', 'address', 'pinCode', 'activities',
          'verificationStatus', 'published', 'submittedBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'shgName', 'shgNameBn', 'area', 'village', 'gramPanchayat', 'block', 'district', 'state',
          'address', 'pinCode', 'lat', 'lng', 'contactName', 'contactPhone',
          'activities', 'services', 'products', 'entrepreneurshipInfo', 'govtSupport',
          'verificationStatus', 'approvalStatus', 'published', 'submittedBy', 'submittedByName',
          'verifiedBy', 'lastVerifiedDate', 'createdAt', 'updatedAt'
        ]) &&
        isValidShgDirectoryListing(incoming()) &&
        (
          isAdmin() ||
          (incoming().verificationStatus == 'PENDING_REVIEW' && incoming().published == false &&
           (!('approvalStatus' in incoming()) || incoming().approvalStatus == 'PENDING'))
        );

      allow update: if isSignedIn() &&
        isValidId(shgId) &&
        isAdmin() &&
        incoming().submittedBy == existing().submittedBy &&
        incoming().createdAt == existing().createdAt &&
        isValidShgDirectoryListing(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'shgName', 'shgNameBn', 'area', 'village', 'gramPanchayat', 'block', 'district', 'state',
          'address', 'pinCode', 'lat', 'lng', 'contactName', 'contactPhone',
          'activities', 'services', 'products', 'entrepreneurshipInfo', 'govtSupport',
          'verificationStatus', 'approvalStatus', 'published', 'verifiedBy', 'lastVerifiedDate', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(shgId) && isAdmin();
    }

    // --- PHASE 5: IMMUTABLE DIRECTORY SUBMISSION & ADMIN APPROVAL AUDIT TRAIL ---
    match /directoryAuditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (isAdmin() || existing().actorUid == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || existing().actorUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(logId) &&
        incoming().actorUid == request.auth.uid &&
        incoming().keys().hasAll(['entityType', 'entityId', 'entityName', 'action', 'actorUid', 'createdAt']) &&
        incoming().keys().hasOnly(['entityType', 'entityId', 'entityName', 'action', 'actorUid', 'actorName', 'pinCode', 'summary', 'createdAt']) &&
        isValidDirectoryAuditLog(incoming()) &&
        (
          isAdmin() ||
          incoming().action in ['SHOP_SUBMITTED', 'SHG_SUBMITTED']
        );
      allow update, delete: if false;
    }

    // --- PHASE 6: SKILL ZONE TRAINING PROGRAMS (/skillPrograms — Public Published Only, Admin CRUD) ---
    match /skillPrograms/{programId} {
      allow get: if isValidId(programId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(programId) &&
        isAdmin() &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll([
          'title', 'category', 'targetRoles', 'provider', 'description',
          'lessons', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'titleBn', 'category', 'targetRoles', 'provider', 'description',
          'eligibility', 'duration', 'verifiedFees', 'certificateDetails',
          'youtubeUrl', 'courseUrl', 'pdfUrl', 'applicationUrl', 'officialSourceUrl',
          'certificateUrl', 'lessons', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidSkillProgram(incoming());

      allow update: if isSignedIn() &&
        isValidId(programId) &&
        isAdmin() &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isValidSkillProgram(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'titleBn', 'category', 'targetRoles', 'provider', 'description',
          'eligibility', 'duration', 'verifiedFees', 'certificateDetails',
          'youtubeUrl', 'courseUrl', 'pdfUrl', 'applicationUrl', 'officialSourceUrl',
          'certificateUrl', 'lessons', 'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(programId) && isAdmin();
    }

    // --- PHASE 6: SKILL ZONE JOB & CAREER PREPARATION RESOURCES (/skillCareerResources — Public Published Only, Admin CRUD) ---
    match /skillCareerResources/{resourceId} {
      allow get: if isValidId(resourceId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isSignedIn() &&
        isValidId(resourceId) &&
        isAdmin() &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll([
          'title', 'recordKind', 'prepCategory', 'targetRoles', 'organization',
          'summary', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'titleBn', 'recordKind', 'prepCategory', 'targetRoles', 'organization',
          'summary', 'eligibility', 'deadline', 'officialSourceUrl', 'applicationUrl',
          'youtubeUrl', 'pdfUrl', 'verifiedNote', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidSkillCareerResource(incoming());

      allow update: if isSignedIn() &&
        isValidId(resourceId) &&
        isAdmin() &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isValidSkillCareerResource(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'titleBn', 'recordKind', 'prepCategory', 'targetRoles', 'organization',
          'summary', 'eligibility', 'deadline', 'officialSourceUrl', 'applicationUrl',
          'youtubeUrl', 'pdfUrl', 'verifiedNote', 'published', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(resourceId) && isAdmin();
    }
  }
}
