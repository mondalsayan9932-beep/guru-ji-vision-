rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (
          ('email' in request.auth.token) &&
          ('email_verified' in request.auth.token) &&
          request.auth.token.email == 'mondalsayan9932@gmail.com' &&
          request.auth.token.email_verified == true
        ) ||
        (('founder' in request.auth.token) && request.auth.token.founder == true) ||
        (('role' in request.auth.token) && request.auth.token.role == 'FOUNDER')
      );
    }

    function isAdmin() {
      return isSuperAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function hasVerifiedEmail(expectedEmail) {
      return isSignedIn() &&
        expectedEmail is string &&
        expectedEmail.size() >= 3 &&
        ('email' in request.auth.token) &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == expectedEmail;
    }

    function isKnownFacultyEmail() {
      return isSignedIn() &&
        ('email' in request.auth.token) &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'anuman.lin@gmail.com',
          'sudipbhattacharya234@gmail.com',
          'pratonu31@gmail.com',
          'subhaspatar@gmail.com',
          'soumyasjd@gmail.com',
          'bhowmik.anirban1@gmail.com',
          'sardarbiswanath8597@gmail.com'
        ];
    }

    function isAuthorizedMeetingHost() {
      return isAdmin() ||
        isKnownFacultyEmail() ||
        (
          isSignedIn() &&
          exists(/databases/$(database)/documents/professorAccounts/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/professorAccounts/$(request.auth.uid)).data.active == true &&
          get(/databases/$(database)/documents/professorAccounts/$(request.auth.uid)).data.canHostMeetings == true
        );
    }

    function isAssignedProfessorForThread(data) {
      return isSignedIn() && (
        (data.professorUid is string && data.professorUid.size() >= 1 && data.professorUid == request.auth.uid) ||
        hasVerifiedEmail(data.professorEmail) ||
        (
          exists(/databases/$(database)/documents/professorAccounts/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/professorAccounts/$(request.auth.uid)).data.active == true &&
          get(/databases/$(database)/documents/professorAccounts/$(request.auth.uid)).data.professorId == data.professorId
        )
      );
    }

    // --- VALIDATION BLUEPRINTS (Anti-Update-Gap) ---

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.role in ['STUDENT', 'FARMER', 'PROFESSOR'] &&
        data.institutionOrVillage is string && data.institutionOrVillage.size() <= 120 &&
        data.district is string && data.district.size() <= 80 &&
        data.semester is int && data.semester >= 0 && data.semester <= 8 &&
        data.language in ['EN', 'BN'] &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 25)) &&
        (!('state' in data) || (data.state is string && data.state.size() <= 80)) &&
        (!('department' in data) || (data.department is string && data.department.size() <= 100)) &&
        (!('subjectSpecialization' in data) || (data.subjectSpecialization is string && data.subjectSpecialization.size() <= 160)) &&
        (!('requestedRole' in data) || data.requestedRole in ['STUDENT', 'FARMER', 'PROFESSOR']) &&
        (!('professorApprovalStatus' in data) || data.professorApprovalStatus in ['NONE', 'PENDING', 'APPROVED', 'REJECTED']) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        (!('financialProfiles' in data) || (
          data.financialProfiles is list &&
          data.financialProfiles.size() >= 1 &&
          data.financialProfiles.size() <= 2 &&
          data.financialProfiles.hasOnly(['student', 'farmer'])
        )) &&
        (!('lastActiveAt' in data) || isValidTimestamp(data.lastActiveAt)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function userDocExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userRoleOf(uid) {
      return userDocExists(uid) ? get(/databases/$(database)/documents/users/$(uid)).data.role : '';
    }

    function userFinancialProfilesOf(uid) {
      return (
        userDocExists(uid) &&
        ('financialProfiles' in get(/databases/$(database)/documents/users/$(uid)).data) &&
        get(/databases/$(database)/documents/users/$(uid)).data.financialProfiles is list
      ) ? get(/databases/$(database)/documents/users/$(uid)).data.financialProfiles : [];
    }

    function hasStudentFinancialAccess(uid) {
      return isOwner(uid) && (
        userRoleOf(uid) in ['STUDENT', 'PROFESSOR'] ||
        'student' in userFinancialProfilesOf(uid)
      );
    }

    function hasFarmerFinancialAccess(uid) {
      return isOwner(uid) && (
        userRoleOf(uid) == 'FARMER' ||
        'farmer' in userFinancialProfilesOf(uid)
      );
    }

    function isValidStudentFinancialTransaction(data, uid) {
      return data.userId is string && data.userId == uid &&
        data.profileType == 'student' &&
        data.ledgerScope == 'STUDENT' &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
        data.type in ['INCOME', 'EXPENSE'] &&
        data.category in [
          'EDUCATION', 'BOOKS_STATIONERY', 'HOSTEL_RENT', 'FOOD_MESS',
          'PERSONAL_EXPENSE', 'TRAVEL_RECHARGE', 'SHARED', 'SAVINGS',
          'ALLOWANCE', 'SCHOLARSHIP', 'SAVINGS_RETURN', 'OTHER'
        ] &&
        data.note is string && data.note.size() <= 300 &&
        data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 30 &&
        (!('sharedWith' in data) || (data.sharedWith is string && data.sharedWith.size() <= 100)) &&
        (!('migratedFromLegacyId' in data) || (data.migratedFromLegacyId is string && data.migratedFromLegacyId.size() <= 128)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFarmerFinancialTransaction(data, uid) {
      return data.userId is string && data.userId == uid &&
        data.profileType == 'farmer' &&
        data.ledgerScope == 'FARMER' &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
        data.type in ['INCOME', 'EXPENSE'] &&
        data.category in [
          'CROP_EXPENSE', 'SEEDS', 'FERTILIZERS', 'PESTICIDES', 'LABOUR_COSTS',
          'IRRIGATION', 'LAND_LEASE', 'FARM_LOAN_REPAYMENT', 'MACHINERY_TRANSPORT',
          'LIVESTOCK_DAIRY', 'CROP_SALES', 'FARM_LOAN_RECEIVED', 'GOVT_SUBSIDY',
          'LAND_LEASE_INCOME', 'OTHER_FARM',
          'SEEDS_FERTILIZER', 'IRRIGATION_PESTICIDE', 'LABOUR_MACHINERY', 'HARVEST_SALE'
        ] &&
        data.note is string && data.note.size() <= 300 &&
        data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 30 &&
        (!('cropTag' in data) || (data.cropTag is string && data.cropTag.size() <= 60)) &&
        (!('migratedFromLegacyId' in data) || (data.migratedFromLegacyId is string && data.migratedFromLegacyId.size() <= 128)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidScopedFinancialBudget(data, uid, expectedProfile, expectedScope) {
      return data.userId is string && data.userId == uid &&
        data.profileType == expectedProfile &&
        data.ledgerScope == expectedScope &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.kind in ['MONTHLY_BUDGET', 'SAVINGS_GOAL', 'OPENING_BALANCE'] &&
        data.targetAmount is number && data.targetAmount >= 0 && data.targetAmount <= 10000000 &&
        (data.kind == 'OPENING_BALANCE' || data.targetAmount > 0) &&
        data.savedAmount is number && data.savedAmount >= 0 && data.savedAmount <= 10000000 &&
        data.monthKey is string && data.monthKey.size() >= 4 && data.monthKey.size() <= 20 &&
        (!('migratedFromLegacyId' in data) || (data.migratedFromLegacyId is string && data.migratedFromLegacyId.size() <= 128)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidMoneyTransaction(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
        data.type in ['INCOME', 'EXPENSE'] &&
        data.category in [
          'FOOD_MESS', 'HOSTEL_RENT', 'EDUCATION', 'TRAVEL_RECHARGE', 'SHARED', 'SAVINGS', 'ALLOWANCE', 'SCHOLARSHIP', 'OTHER',
          'SEEDS_FERTILIZER', 'LABOUR_MACHINERY', 'IRRIGATION_PESTICIDE', 'HARVEST_SALE', 'GOVT_SUBSIDY', 'LIVESTOCK_DAIRY'
        ] &&
        data.note is string && data.note.size() <= 300 &&
        data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 30 &&
        (!('sharedWith' in data) || (data.sharedWith is string && data.sharedWith.size() <= 100)) &&
        (!('ledgerScope' in data) || data.ledgerScope in ['STUDENT', 'FARMER']) &&
        (!('cropTag' in data) || (data.cropTag is string && data.cropTag.size() <= 60)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFinancialGoal(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.kind in ['MONTHLY_BUDGET', 'SAVINGS_GOAL', 'OPENING_BALANCE'] &&
        data.targetAmount is number && data.targetAmount >= 0 && data.targetAmount <= 10000000 &&
        (data.kind == 'OPENING_BALANCE' || data.targetAmount > 0) &&
        data.savedAmount is number && data.savedAmount >= 0 && data.savedAmount <= 10000000 &&
        data.monthKey is string && data.monthKey.size() >= 4 && data.monthKey.size() <= 20 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidQuizAttempt(data) {
      return data.semester is int && data.semester >= 1 && data.semester <= 8 &&
        data.score is int && data.score >= 0 && data.score <= 200 &&
        data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 200 &&
        data.score <= data.totalQuestions &&
        (!('mode' in data) || data.mode in ['PRACTICE', 'MOCK_TEST', 'PYQ_SET']) &&
        (!('examCategory' in data) || data.examCategory in [
          'ALL', 'BSC_SEMESTER', 'ICAR_ENTRANCE', 'ICAR_JRF', 'CUET_PG', 'IBPS_AFO', 'NABARD', 'STATE_AO', 'OTHER_COMPETITIVE'
        ]) &&
        (!('subjectKey' in data) || (data.subjectKey is string && data.subjectKey.size() <= 40)) &&
        (!('durationSec' in data) || (data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 28800)) &&
        isValidTimestamp(data.createdAt);
    }

    function isValidStudyBookmark(data) {
      return data.itemType in ['NOTE', 'MCQ', 'SYLLABUS', 'PROGRESS', 'VIDEO', 'RESOURCE'] &&
        data.itemId is string && data.itemId.size() >= 1 && data.itemId.size() <= 140 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 100)) &&
        (!('semester' in data) || (data.semester is int && data.semester >= 0 && data.semester <= 8)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFarmerQuery(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.farmerName is string && data.farmerName.size() >= 1 && data.farmerName.size() <= 80 &&
        data.cropName is string && data.cropName.size() >= 1 && data.cropName.size() <= 80 &&
        data.category in ['DISEASE', 'PEST', 'FERTILIZER', 'SOIL', 'WEATHER', 'OTHER'] &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        data.district is string && data.district.size() <= 80 &&
        data.hasImage is bool &&
        data.imageSummary is string && data.imageSummary.size() <= 400 &&
        (!('imageBase64' in data) || (data.imageBase64 is string && data.imageBase64.size() <= 350000)) &&
        data.status in ['OPEN', 'IN_REVIEW', 'RESOLVED'] &&
        data.adminReply is string && data.adminReply.size() <= 1000 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidMarketPrice(data) {
      return data.cropName is string && data.cropName.size() >= 2 && data.cropName.size() <= 80 &&
        (!('cropNameBn' in data) || (data.cropNameBn is string && data.cropNameBn.size() <= 80)) &&
        data.state is string && data.state.size() >= 2 && data.state.size() <= 60 &&
        data.district is string && data.district.size() >= 2 && data.district.size() <= 80 &&
        data.marketName is string && data.marketName.size() >= 2 && data.marketName.size() <= 100 &&
        data.unit is string && data.unit.size() >= 2 && data.unit.size() <= 40 &&
        data.minPrice is number && data.minPrice >= 0 && data.minPrice <= 1000000 &&
        data.maxPrice is number && data.maxPrice >= data.minPrice && data.maxPrice <= 1000000 &&
        data.modalPrice is number && data.modalPrice >= 0 && data.modalPrice <= 1000000 &&
        data.reportDate is string && data.reportDate.size() >= 6 && data.reportDate.size() <= 30 &&
        data.sourceName is string && data.sourceName.size() >= 2 && data.sourceName.size() <= 120 &&
        (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 400)) &&
        data.published is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidStudyMaterialExtras(data) {
      return (!('language' in data) || data.language in ['EN', 'BN', 'HI', 'BILINGUAL']) &&
        (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 400)) &&
        (!('youtubeVideoId' in data) || (data.youtubeVideoId is string && data.youtubeVideoId.size() <= 20)) &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 400)) &&
        (!('examCategory' in data) || data.examCategory in [
          'ALL', 'BSC_SEMESTER', 'ICAR_ENTRANCE', 'ICAR_JRF', 'CUET_PG', 'IBPS_AFO', 'NABARD', 'STATE_AO', 'OTHER_COMPETITIVE'
        ]) &&
        (!('examYear' in data) || (data.examYear is string && data.examYear.size() <= 20)) &&
        (!('answerKeyUrl' in data) || (data.answerKeyUrl is string && data.answerKeyUrl.size() <= 400)) &&
        (!('pyqOrigin' in data) || data.pyqOrigin in ['OFFICIAL_PYQ', 'PRACTICE_SET', 'AI_PRACTICE']) &&
        (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 180)) &&
        (!('fileType' in data) || (data.fileType is string && data.fileType.size() <= 20));
    }

    function isValidStudyMaterial(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
        (!('titleBn' in data) || (data.titleBn is string && data.titleBn.size() <= 180)) &&
        data.semester is int && data.semester >= 1 && data.semester <= 8 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 80 &&
        (!('subjectKey' in data) || data.subjectKey in [
          'AGRONOMY', 'SOIL_SCIENCE', 'GENETICS_BREEDING', 'PLANT_PATHOLOGY', 'ENTOMOLOGY',
          'HORTICULTURE', 'AGRI_ECONOMICS', 'AGRI_EXTENSION', 'SEED_SCIENCE', 'PLANT_PHYSIOLOGY',
          'AGRI_ENGINEERING', 'ANIMAL_HUSBANDRY', 'OTHER'
        ]) &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 120)) &&
        data.category in ['NOTES_PDF', 'VIDEO_LECTURE', 'PYQ', 'PRACTICAL'] &&
        data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 1000 &&
        (!('summaryBn' in data) || (data.summaryBn is string && data.summaryBn.size() <= 1000)) &&
        (!('contentText' in data) || (data.contentText is string && data.contentText.size() <= 12000)) &&
        (!('contentTextBn' in data) || (data.contentTextBn is string && data.contentTextBn.size() <= 12000)) &&
        (!('sourceName' in data) || (data.sourceName is string && data.sourceName.size() <= 140)) &&
        (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 400)) &&
        (!('referenceCitation' in data) || (data.referenceCitation is string && data.referenceCitation.size() <= 300)) &&
        (!('lastUpdatedDate' in data) || (data.lastUpdatedDate is string && data.lastUpdatedDate.size() <= 30)) &&
        (!('downloadPermitted' in data) || data.downloadPermitted is bool) &&
        (!('contentOrigin' in data) || data.contentOrigin in ['OFFICIAL_PUBLICATION', 'VERIFIED_FACULTY', 'CURATED_REFERENCE', 'AI_PRACTICE']) &&
        (!('examTags' in data) || (data.examTags is list && data.examTags.size() <= 10)) &&
        (!('popularityScore' in data) || (data.popularityScore is int && data.popularityScore >= 0 && data.popularityScore <= 1000000)) &&
        (!('verifiedForAi' in data) || data.verifiedForAi is bool) &&
        isValidStudyMaterialExtras(data) &&
        data.resourceUrl is string && data.resourceUrl.size() <= 400 &&
        data.published is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidQuizQuestion(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.semester is int && data.semester >= 1 && data.semester <= 8 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 80 &&
        (!('subjectKey' in data) || data.subjectKey in [
          'AGRONOMY', 'SOIL_SCIENCE', 'GENETICS_BREEDING', 'PLANT_PATHOLOGY', 'ENTOMOLOGY',
          'HORTICULTURE', 'AGRI_ECONOMICS', 'AGRI_EXTENSION', 'SEED_SCIENCE', 'PLANT_PHYSIOLOGY',
          'AGRI_ENGINEERING', 'ANIMAL_HUSBANDRY', 'OTHER'
        ]) &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 120)) &&
        data.questionText is string && data.questionText.size() >= 5 && data.questionText.size() <= 500 &&
        (!('questionTextBn' in data) || (data.questionTextBn is string && data.questionTextBn.size() <= 500)) &&
        data.options is list && data.options.size() == 4 &&
        data.options[0] is string && data.options[0].size() >= 1 && data.options[0].size() <= 160 &&
        data.options[1] is string && data.options[1].size() >= 1 && data.options[1].size() <= 160 &&
        data.options[2] is string && data.options[2].size() >= 1 && data.options[2].size() <= 160 &&
        data.options[3] is string && data.options[3].size() >= 1 && data.options[3].size() <= 160 &&
        data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex <= 3 &&
        data.explanation is string && data.explanation.size() <= 500 &&
        (!('explanationBn' in data) || (data.explanationBn is string && data.explanationBn.size() <= 500)) &&
        (!('questionType' in data) || data.questionType in ['OFFICIAL_PYQ', 'VERIFIED_PUBLISHED', 'PRACTICE', 'AI_GENERATED']) &&
        (!('difficulty' in data) || data.difficulty in ['EASY', 'MEDIUM', 'HARD']) &&
        (!('examCategory' in data) || data.examCategory in [
          'BSC_SEMESTER', 'ICAR_ENTRANCE', 'ICAR_JRF', 'CUET_PG', 'IBPS_AFO', 'NABARD', 'STATE_AO', 'OTHER_COMPETITIVE'
        ]) &&
        (!('examYear' in data) || (data.examYear is string && data.examYear.size() <= 20)) &&
        (!('sourcePaper' in data) || (data.sourcePaper is string && data.sourcePaper.size() <= 160)) &&
        (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 400)) &&
        data.published is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidUniversitySyllabus(data) {
      return data.university is string && data.university.size() >= 2 && data.university.size() <= 160 &&
        data.universityShort is string && data.universityShort.size() >= 2 && data.universityShort.size() <= 60 &&
        data.course is string && data.course.size() >= 2 && data.course.size() <= 120 &&
        data.semester is int && data.semester >= 1 && data.semester <= 8 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 140 &&
        (!('subjectKey' in data) || data.subjectKey in [
          'AGRONOMY', 'SOIL_SCIENCE', 'GENETICS_BREEDING', 'PLANT_PATHOLOGY', 'ENTOMOLOGY',
          'HORTICULTURE', 'AGRI_ECONOMICS', 'AGRI_EXTENSION', 'SEED_SCIENCE', 'PLANT_PHYSIOLOGY',
          'AGRI_ENGINEERING', 'ANIMAL_HUSBANDRY', 'OTHER'
        ]) &&
        data.topics is list && data.topics.size() <= 40 &&
        data.publicationYear is string && data.publicationYear.size() >= 4 && data.publicationYear.size() <= 60 &&
        (!('academicSession' in data) || (data.academicSession is string && data.academicSession.size() <= 40)) &&
        data.sourceUrl is string && data.sourceUrl.size() <= 400 &&
        (!('pdfUrl' in data) || (data.pdfUrl is string && data.pdfUrl.size() <= 400)) &&
        (!('downloadPermitted' in data) || data.downloadPermitted is bool) &&
        data.published is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidDiscoveredStudyResource(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
        data.sourceWebsite is string && data.sourceWebsite.size() >= 2 && data.sourceWebsite.size() <= 140 &&
        data.publicationDate is string && data.publicationDate.size() >= 4 && data.publicationDate.size() <= 30 &&
        data.subjectKey in [
          'AGRONOMY', 'SOIL_SCIENCE', 'GENETICS_BREEDING', 'PLANT_PATHOLOGY', 'ENTOMOLOGY',
          'HORTICULTURE', 'AGRI_ECONOMICS', 'AGRI_EXTENSION', 'SEED_SCIENCE', 'PLANT_PHYSIOLOGY',
          'AGRI_ENGINEERING', 'ANIMAL_HUSBANDRY', 'OTHER'
        ] &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120 &&
        data.category in [
          'NOTES_PDF', 'PYQ', 'PRACTICAL', 'SYLLABUS', 'EXAM_NOTIFICATION',
          'ICAR_RESOURCE', 'UNIVERSITY_MATERIAL', 'RESEARCH_PAPER',
          'GOVT_PUBLICATION', 'YOUTUBE_PLAYLIST', 'BOOK_REFERENCE', 'OFFICIAL_NOTIFICATION'
        ] &&
        data.sourceUrl is string && data.sourceUrl.size() >= 8 && data.sourceUrl.size() <= 400 &&
        data.dedupeKey is string && data.dedupeKey.size() >= 3 && data.dedupeKey.size() <= 240 &&
        data.discoveryMethod in ['RSS_FEED', 'PUBLIC_API', 'ADMIN_SUBMITTED'] &&
        data.reviewStatus in ['PENDING_REVIEW', 'APPROVED_PUBLISHED', 'REJECTED'] &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 500)) &&
